    local function animateClickRipple(animateClickRippleButton)
        local animateClickRipplePosition = getPointerPosition()
        local animateClickRippleMaximum = math.max(
            animateClickRippleButton.AbsoluteSize.X,
            animateClickRippleButton.AbsoluteSize.Y
        ) * 2.2
        local animateClickRippleTarget = table.remove(items)

        if
            animateClickRippleTarget and not pcall(function()
                animateClickRippleTarget.Parent = nil
            end)
        then
            animateClickRippleTarget = nil
        end
        if not animateClickRippleTarget then
            animateClickRippleTarget = createInstance("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5),
                BackgroundColor3 = themeColors.Accent,
                BorderSizePixel = 0,
            })
            addCorner(animateClickRippleTarget, UDim.new(1, 0))
        end
        animateClickRippleTarget.Position = UDim2.fromOffset(
            animateClickRipplePosition.X - animateClickRippleButton.AbsolutePosition.X,
            animateClickRipplePosition.Y - animateClickRippleButton.AbsolutePosition.Y
        )
        animateClickRippleTarget.Size = UDim2.fromOffset(0, 0)
        animateClickRippleTarget.BackgroundColor3 = themeColors.Accent
        animateClickRippleTarget.BackgroundTransparency = 0.82
        animateClickRippleTarget.ZIndex = animateClickRippleButton.ZIndex + 1
        animateClickRippleTarget.Parent = animateClickRippleButton
        tweenProperties(
            animateClickRippleTarget,
            { Size = UDim2.fromOffset(animateClickRippleMaximum, animateClickRippleMaximum), BackgroundTransparency = 1 },
            0.55
        )
        task.delay(0.55, function()
            if animateClickRippleTarget.Parent ~= animateClickRippleButton or not animateClickRippleButton.Parent then
                pcall(animateClickRippleTarget.Destroy, animateClickRippleTarget)
                return
            end
            animateClickRippleTarget.Parent = nil
            if #items < 4 then
                table.insert(items, animateClickRippleTarget)
            else
                animateClickRippleTarget:Destroy()
            end
        end)
    end

