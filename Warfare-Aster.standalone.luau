    local tweenService = game:GetService("TweenService")
    local userInputService = game:GetService("UserInputService")
    local guiService = game:GetService("GuiService")
    local runService = game:GetService("RunService")
    local httpService = game:GetService("HttpService")
    local playersService = game:GetService("Players")
    local teleportService = game:GetService("TeleportService")
    local marketplaceService = game:GetService("MarketplaceService")
    local statsService = game:GetService("Stats")

    local localPlayer = playersService.LocalPlayer

    local flowLibrary = {}

    flowLibrary.Flags = {}
    flowLibrary.Windows = {}

    local function normalizeOptions(suppliedOptions, optionAliases)
        local normalizedOptions = {}
        if type(suppliedOptions) == "string" then
            normalizedOptions.Name = suppliedOptions
        elseif type(suppliedOptions) == "table" then
            for optionKey, optionValue in pairs(suppliedOptions) do
                normalizedOptions[optionKey] = optionValue
            end
        end
        for aliasKey, canonicalKey in pairs(optionAliases or {}) do
            if normalizedOptions[canonicalKey] == nil and normalizedOptions[aliasKey] ~= nil then
                normalizedOptions[canonicalKey] = normalizedOptions[aliasKey]
            end
        end
        if normalizedOptions.Range then
            normalizedOptions.Min = normalizedOptions.Min or normalizedOptions.Range[1]
            normalizedOptions.Max = normalizedOptions.Max or normalizedOptions.Range[2]
        end
        return normalizedOptions
    end

    local function bindControlLifecycle(controlContainer, controlOptions, controlObject, controlFrame, controlKind)
        controlObject._type = controlKind
        controlObject._frame = controlFrame
        controlObject._listeners = controlObject._listeners or {}
        local ownerWindow = controlContainer and controlContainer.Window
        local controlSearchName = controlOptions.Name or controlOptions.Text or controlOptions.Title
        controlObject._searchName = type(controlSearchName) == "string" and controlSearchName or ""
        controlObject._searchKey = string.lower(controlObject._searchName)
        if controlContainer and controlContainer._items then
            table.insert(controlContainer._items, controlObject)
        end
        if controlOptions.Flag then
            flowLibrary.Flags[controlOptions.Flag] = controlObject
            if ownerWindow then
                ownerWindow:_flagCreated(controlOptions.Flag, controlObject)
            end
        end
        controlObject._userVisible = controlOptions.Visible ~= false
        function controlObject:IsVisible()
            return controlObject._userVisible
        end
        function controlObject:_isShown()
            return controlObject._userVisible and not (controlContainer and controlContainer._userVisible == false)
        end
        function controlObject:SetVisible(visible)
            visible = visible and true or false
            if visible == controlObject._userVisible or controlObject._destroyed then
                return
            end
            controlObject._userVisible = visible
            if not visible then
                if controlObject._onHide then
                    controlObject._onHide()
                end
                if controlObject.Open and type(controlObject.SetOpen) == "function" then
                    controlObject:SetOpen(false)
                end
            end
            if controlFrame then
                controlFrame.Visible = visible
            end
            if ownerWindow then
                ownerWindow._controlsDirty = true
            end
        end
        if controlFrame and not controlObject._userVisible then
            controlFrame.Visible = false
        end

        function controlObject:SetTooltip(setTooltipTooltip)
            controlObject._tooltip = setTooltipTooltip
            if controlFrame and ownerWindow and not controlObject._tooltipBound then
                controlObject._tooltipBound = true
                ownerWindow:_attachTooltip(controlObject, controlFrame)
            end
        end
        function controlObject:GetTooltip()
            return controlObject._tooltip
        end
        if controlOptions.Tooltip ~= nil and controlOptions.Tooltip ~= false then
            controlObject:SetTooltip(controlOptions.Tooltip)
        end
        function controlObject:Destroy()
            if controlObject._destroyed then
                return
            end
            controlObject._destroyed = true
            if ownerWindow and ownerWindow._tipOwner == controlObject then
                ownerWindow:_hideTooltip()
            end
            for destroyKey, destroyItem in ipairs(controlObject._listeners) do
                destroyItem()
            end
            controlObject._listeners = {}
            if controlContainer and controlContainer._items then
                local controlListIndex = table.find(controlContainer._items, controlObject)
                if controlListIndex then
                    table.remove(controlContainer._items, controlListIndex)
                end
            end
            if controlOptions.Flag and flowLibrary.Flags[controlOptions.Flag] == controlObject then
                flowLibrary.Flags[controlOptions.Flag] = nil
            end
            if ownerWindow then
                ownerWindow._controlsDirty = true
            end
            if controlFrame then
                controlFrame:Destroy()
            end
        end
        return controlObject
    end

