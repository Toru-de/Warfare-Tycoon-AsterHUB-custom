    function executorNoticeStorage.DisclaimerKey(disclaimerKeyValue)
        if disclaimerKeyValue.Id ~= nil then
            return (tostring(disclaimerKeyValue.Id):gsub("[\r\n]", " "))
        end
        local disclaimerKeyText = tostring(disclaimerKeyValue.Title) .. "\000" .. tostring(disclaimerKeyValue.Text)
        local disclaimerKeyOffset = 5381
        for disclaimerKeyIndex = 1, #disclaimerKeyText do
            disclaimerKeyOffset = (disclaimerKeyOffset * 33 + disclaimerKeyText:byte(disclaimerKeyIndex)) % 4294967296
        end
        return string.format("%08x", disclaimerKeyOffset)
    end

    function executorNoticeStorage.DisclaimerAccepted(disclaimerAcceptedValue, disclaimerAcceptedArgument)
        if not executorNoticeStorage.Available() then
