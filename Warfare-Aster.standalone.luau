    function WindowMethods:_homeStats(
        windowHomeStatsValue,
        windowHomeStatsArgument,
        windowHomeStatsArgument2,
        windowHomeStatsArgument3
    )
        local windowHomeStatsStats = windowHomeStatsArgument.Stats
            or { "Players", "Friends", "Execs", "Session", "FPS", "Ping" }
        local windowHomeStatsFrame = createInstance("Frame", {
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
            LayoutOrder = windowHomeStatsArgument2,
            Parent = windowHomeStatsValue,
        })
        local windowHomeStatsUIGridLayout = createInstance("UIGridLayout", {
            CellPadding = UDim2.fromOffset(8, 8),
            CellSize = UDim2.new(1 / 6, -7, 0, 64),
            SortOrder = Enum.SortOrder.LayoutOrder,
            Parent = windowHomeStatsFrame,
        })
        local windowHomeStatsItems = {}
        local windowHomeStatsOffset = 0
        for windowHomeStatsKey, windowHomeStatsItem in ipairs(windowHomeStatsStats) do
            local windowHomeStatsPlayersDataEntry = playersData[windowHomeStatsItem]
            if windowHomeStatsPlayersDataEntry and not windowHomeStatsItems[windowHomeStatsItem] then
                windowHomeStatsOffset += 1
                windowHomeStatsItems[windowHomeStatsItem] = createConfigCard(
                    windowHomeStatsFrame,
                    windowHomeStatsOffset,
                    windowHomeStatsPlayersDataEntry[1],
                    windowHomeStatsPlayersDataEntry[2]
                )
            end
        end
        local function updateWindowHomeStatsState()
            local updateWindowHomeStatsStateX = windowHomeStatsFrame.AbsoluteSize.X / self.Scale.Scale
            local updateWindowHomeStatsStateMaximum =
                math.max(math.min(windowHomeStatsOffset, updateWindowHomeStatsStateX >= 520 and 6 or 3), 1)
            windowHomeStatsUIGridLayout.CellSize = UDim2.new(
                1 / updateWindowHomeStatsStateMaximum,
                -math.ceil(8 * (updateWindowHomeStatsStateMaximum - 1) / updateWindowHomeStatsStateMaximum),
                0,
                64
            )
        end
        windowHomeStatsFrame:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateWindowHomeStatsState)
        task.defer(updateWindowHomeStatsState)

        if windowHomeStatsItems.Executor then
            windowHomeStatsItems.Executor.Text = getExecutorName()
        end
        if windowHomeStatsItems.Game then
            windowHomeStatsItems.Game.Text = "Loading"
            task.spawn(function()
                windowHomeStatsItems.Game.Text = getExperienceTitle()
            end)
        end
        if windowHomeStatsItems.Region then
            windowHomeStatsItems.Region.Text = "Loading"
            reportUnavailableExperience(function(windowHomeStatsText)
                windowHomeStatsItems.Region.Text = windowHomeStatsText
            end)
        end
        if windowHomeStatsItems.Execs then
            local windowHomeStatsStateValue = readOptionalFile(windowHomeStatsArgument.StatsFolder or self.ConfigFolder)
            windowHomeStatsItems.Execs.Text = windowHomeStatsStateValue and tostring(windowHomeStatsStateValue) or "—"
        end
        if windowHomeStatsItems.Friends then
            local windowHomeStatsItems2 = {}
            local function updateWindowHomeStatsText()
                local updateWindowHomeStatsTextOffset = 0
                for updateWindowHomeStatsTextKey, updateWindowHomeStatsTextItem in ipairs(playersService:GetPlayers()) do
                    if updateWindowHomeStatsTextItem ~= localPlayer then
                        local updateWindowHomeStatsTextItemsEntry =
                            windowHomeStatsItems2[updateWindowHomeStatsTextItem.UserId]
                        if updateWindowHomeStatsTextItemsEntry == nil then
                            local updateWindowHomeStatsTextSucceeded, updateWindowHomeStatsTextResult = pcall(function()
                                return localPlayer:IsFriendsWith(updateWindowHomeStatsTextItem.UserId)
                            end)
                            updateWindowHomeStatsTextItemsEntry = updateWindowHomeStatsTextSucceeded
                                and updateWindowHomeStatsTextResult == true
                            windowHomeStatsItems2[updateWindowHomeStatsTextItem.UserId] =
                                updateWindowHomeStatsTextItemsEntry
                        end
                        if updateWindowHomeStatsTextItemsEntry then
                            updateWindowHomeStatsTextOffset += 1
                        end
                    end
                end
                windowHomeStatsItems.Friends.Text = tostring(updateWindowHomeStatsTextOffset)
            end
            task.spawn(updateWindowHomeStatsText)
            table.insert(
                self._connections,
                playersService.PlayerAdded:Connect(function()
                    task.spawn(updateWindowHomeStatsText)
                end)
            )
            table.insert(
                self._connections,
                playersService.PlayerRemoving:Connect(function()
                    task.defer(updateWindowHomeStatsText)
                end)
            )
        end

        local windowHomeStatsSession = windowHomeStatsItems.Session or windowHomeStatsItems.Uptime
        local windowHomeStatsTimestamp = os.clock()
        local windowHomeStatsOffset2 = 0
        self:_listen("Render", function()
            windowHomeStatsOffset2 += 1
        end)

        local windowHomeStatsStatColors = windowHomeStatsArgument.StatColors ~= false
        local function updateWindowHomeStatsState2(updateWindowHomeStatsStateTarget, updateWindowHomeStatsStateArgument)
            if
                windowHomeStatsStatColors
                and updateWindowHomeStatsStateTarget.TextColor3 ~= updateWindowHomeStatsStateArgument
            then
                tweenProperties(
                    updateWindowHomeStatsStateTarget,
                    { TextColor3 = updateWindowHomeStatsStateArgument },
                    0.3
                )
            end
        end
        return function()
            if windowHomeStatsItems.FPS then
                windowHomeStatsItems.FPS.Text = tostring(windowHomeStatsOffset2)
                updateWindowHomeStatsState2(
                    windowHomeStatsItems.FPS,
                    flowLibrary._healthColor(windowHomeStatsOffset2, 50, 30)
                )
            end
            windowHomeStatsOffset2 = 0
            if windowHomeStatsItems.Ping then
                local windowHomeStatsSucceeded, windowHomeStatsResult = pcall(function()
                    return math.floor(localPlayer:GetNetworkPing() * 1000)
                end)
                windowHomeStatsResult = windowHomeStatsSucceeded and windowHomeStatsResult or 0
                windowHomeStatsItems.Ping.Text = windowHomeStatsResult .. "ms"
                updateWindowHomeStatsState2(
                    windowHomeStatsItems.Ping,
                    flowLibrary._healthColor(windowHomeStatsResult, 90, 180, true)
                )
            end
            if windowHomeStatsItems.Players then
                windowHomeStatsItems.Players.Text = #playersService:GetPlayers() .. "/" .. playersService.MaxPlayers
            end
            if windowHomeStatsSession then
                windowHomeStatsSession.Text = formatElapsedTime(os.clock() - windowHomeStatsTimestamp)
            end
            if windowHomeStatsItems.Time then
                windowHomeStatsItems.Time.Text = os.date(windowHomeStatsArgument.TimeFormat or "%H:%M")
            end
            if windowHomeStatsItems.ServerAge then
                windowHomeStatsItems.ServerAge.Text = formatElapsedTime(workspace.DistributedGameTime)
            end
            if windowHomeStatsItems.Memory then
                local windowHomeStatsSucceeded2, windowHomeStatsResult2 = pcall(function()
                    return statsService:GetTotalMemoryUsageMb()
                end)
                windowHomeStatsItems.Memory.Text = windowHomeStatsSucceeded2
                        and string.format("%d MB", windowHomeStatsResult2)
                    or "—"
                updateWindowHomeStatsState2(
                    windowHomeStatsItems.Memory,
                    windowHomeStatsSucceeded2 and flowLibrary._healthColor(windowHomeStatsResult2, 1500, 3000, true)
                        or themeColors.Text
                )
            end
        end, function()
            windowHomeStatsOffset2 = 0
        end
    end

    local function applyTabDescription(applyTabDescriptionValue, applyTabDescriptionArgument)
        local applyTabDescriptionList = applyTabDescriptionValue.List
        if type(applyTabDescriptionArgument.Content) == "string" then
            local applyTabDescriptionParent = createConfigBadge(applyTabDescriptionList, 0, 1)
            applyTabDescriptionParent.AutomaticSize = Enum.AutomaticSize.Y
            addPadding(applyTabDescriptionParent, 16, 16, 14, 16)
            createTextLabel({
                Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                Text = applyTabDescriptionArgument.Content,
                TextSize = 13,
                FontFace = fontFaces.Regular,
                TextColor3 = themeColors.Muted,
                TextWrapped = true,
                TextTruncate = Enum.TextTruncate.None,
                TextYAlignment = Enum.TextYAlignment.Top,
                Parent = applyTabDescriptionParent,
            })
        end
        if type(applyTabDescriptionArgument.Entries) == "table" then
            for applyTabDescriptionKey, applyTabDescriptionItem in ipairs(applyTabDescriptionArgument.Entries) do
                local applyTabDescriptionParent2 =
                    createConfigBadge(applyTabDescriptionList, 0, applyTabDescriptionKey + 1)
                applyTabDescriptionParent2.AutomaticSize = Enum.AutomaticSize.Y
                addPadding(applyTabDescriptionParent2, 16, 16, 14, 16)
                createInstance("UIListLayout", {
                    SortOrder = Enum.SortOrder.LayoutOrder,
                    Padding = UDim.new(0, 6),
                    Parent = applyTabDescriptionParent2,
                })
                local applyTabDescriptionFrame = createInstance("Frame", {
                    Size = UDim2.new(1, 0, 0, 20),
                    BackgroundTransparency = 1,
                    LayoutOrder = 1,
                    Parent = applyTabDescriptionParent2,
                })
                createTextLabel({
                    Size = UDim2.new(1, -90, 1, 0),
                    Text = applyTabDescriptionItem.Title or applyTabDescriptionItem.Version or "Update",
                    TextSize = 15,
                    Parent = applyTabDescriptionFrame,
                })
                if applyTabDescriptionItem.Date or applyTabDescriptionItem.Tag then
                    local applyTabDescriptionFrame2 = createInstance("Frame", {
                        AnchorPoint = Vector2.new(1, 0.5),
                        Position = UDim2.new(1, 0, 0.5, 0),
                        Size = UDim2.fromOffset(0, 20),
                        AutomaticSize = Enum.AutomaticSize.X,
                        BackgroundColor3 = themeColors.Surface,
                        BorderSizePixel = 0,
                        Parent = applyTabDescriptionFrame,
                    })
                    addCorner(applyTabDescriptionFrame2, UDim.new(0, 5))
                    addStroke(applyTabDescriptionFrame2)
                    addPadding(applyTabDescriptionFrame2, 8, 8)
                    createTextLabel({
                        Size = UDim2.new(0, 0, 1, 0),
                        AutomaticSize = Enum.AutomaticSize.X,
                        Text = applyTabDescriptionItem.Tag or applyTabDescriptionItem.Date,
                        TextSize = 11,
                        TextColor3 = themeColors.Muted,
                        TextTruncate = Enum.TextTruncate.None,
                        Parent = applyTabDescriptionFrame2,
                    })
                end
                local applyTabDescriptionContent = applyTabDescriptionItem.Content or applyTabDescriptionItem.Body
                if type(applyTabDescriptionItem.Changes) == "table" then
                    applyTabDescriptionContent = "• " .. table.concat(applyTabDescriptionItem.Changes, "\n• ")
                end
                if applyTabDescriptionContent then
                    createTextLabel({
                        Size = UDim2.new(1, 0, 0, 0),
                        AutomaticSize = Enum.AutomaticSize.Y,
                        Text = applyTabDescriptionContent,
                        TextSize = 13,
                        FontFace = fontFaces.Regular,
                        TextColor3 = themeColors.Muted,
                        TextWrapped = true,
                        TextTruncate = Enum.TextTruncate.None,
                        TextYAlignment = Enum.TextYAlignment.Top,
                        LayoutOrder = 2,
                        Parent = applyTabDescriptionParent2,
                    })
                end
            end
        end
        if type(applyTabDescriptionArgument.Build) == "function" then
            spawnProtectedCallback(applyTabDescriptionArgument.Build, applyTabDescriptionValue, applyTabDescriptionList)
        else
            applyTabDescriptionValue._noSearch = true
        end
    end

    function WindowMethods:_buildHome(windowBuildHomeValue)
        self._hideName = windowBuildHomeValue.HideName == true
        self._hideAvatar = windowBuildHomeValue.HideAvatar == true
        self:_renderIdentity(true)
        local windowBuildHomeHome = self:Tab({
            Name = windowBuildHomeValue.Name or "Home",
            Desc = windowBuildHomeValue.Desc,
            Icon = windowBuildHomeValue.Icon or "house",
            PageTitle = windowBuildHomeValue.Title or ("Welcome to " .. self.Title .. "!"),
        })
        windowBuildHomeHome._order = 100
        self.Home = windowBuildHomeHome

        local windowBuildHomePages = windowBuildHomeValue.Pages or windowBuildHomeValue.Tabs
        local windowBuildHomeHome2 = windowBuildHomeHome
        if type(windowBuildHomePages) == "table" and #windowBuildHomePages > 0 then
            windowBuildHomeHome2 = windowBuildHomeHome:SubTab({
                Name = windowBuildHomeValue.OverviewName or "Overview",
                Icon = windowBuildHomeValue.TabIcon or "layout-grid",
            })
        end
        windowBuildHomeHome2._noSearch = true
        windowBuildHomeHome2._order = 100
        local windowBuildHomeList = windowBuildHomeHome2.List

        local windowBuildHomeHomeProfile = self:_homeProfile(windowBuildHomeList, windowBuildHomeValue, 1)
        local windowBuildHomeHomeStats, windowBuildHomeHomeStats2 =
            self:_homeStats(windowBuildHomeList, windowBuildHomeValue, 2, windowBuildHomeHome)
        self:_homeGame(windowBuildHomeList, 3)
        self:_homeExecutor(windowBuildHomeList, windowBuildHomeValue, 4)
        self:_homeLinks(windowBuildHomeList, windowBuildHomeValue, 5)
        local windowBuildHomeHomeFeatures = self:_homeFeatures(windowBuildHomeList, windowBuildHomeValue, 6)

        if type(windowBuildHomePages) == "table" then
            for windowBuildHomeKey, windowBuildHomeItem in ipairs(windowBuildHomePages) do
                applyTabDescription(
                    windowBuildHomeHome:SubTab({
                        Name = windowBuildHomeItem.Name or windowBuildHomeItem.Title or "Page",
                        Icon = windowBuildHomeItem.Icon,
                    }),
                    windowBuildHomeItem
                )
            end
        end

        windowBuildHomeHomeProfile()
        windowBuildHomeHomeStats()
        task.spawn(function()
            while not self._destroyed and windowBuildHomeHome._page.Parent do
                task.wait(1)
                if self.Open and self.CurrentTab == windowBuildHomeHome then
                    windowBuildHomeHomeStats()
                    windowBuildHomeHomeProfile()
                    windowBuildHomeHomeFeatures()
                else
                    windowBuildHomeHomeStats2()
                end
            end
        end)
        return windowBuildHomeHome
    end

    function WindowMethods:Tab(windowTabSuppliedOptions, windowTabIcon)
