                        updateUiModuleStateNumber
                        and updateUiModuleStateNumber2
                        and updateUiModuleStateNumber < updateUiModuleStateNumber2
                    then
                        table.insert(updateUiModuleStateItems, updateUiModuleStateItem)
                    end
                end
            end
            local updateUiModuleStateCount = #updateUiModuleStateItems > 0
                    and updateUiModuleStateArgument2(updateUiModuleStateItems)
                or nil
            if not updateUiModuleStateCount then
                updateUiModuleStateValue:Notify({
                    Title = updateUiModuleStateArgument3 .. " failed",
