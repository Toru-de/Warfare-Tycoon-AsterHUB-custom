-- Aster branding: embedded Base64 PNG and image helpers
local _AsterBrandAssets = (function()
    local brandImagesBase64 = {
        symbol = "",
    }
    local brandAssets, brandAssetCache = {}, {}
    local base64Alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    local base64ByteLookup = {}
    for alphabetIndex = 1, 64 do
        base64ByteLookup[string.byte(base64Alphabet, alphabetIndex)] = alphabetIndex - 1
    end
    local function decodeBrandImageBase64(encodedImage)
        local paddingCount = encodedImage:sub(-2) == "==" and 2 or encodedImage:sub(-1) == "=" and 1 or 0
        local decodedImageBuffer = buffer.create(math.floor(#encodedImage * 3 / 4) - paddingCount)
        local outputByteOffset = 0
        local lastYieldTime = os.clock()
        for inputByteOffset = 1, #encodedImage, 4 do
            local encodedByte1, encodedByte2, encodedByte3, encodedByte4 =
                string.byte(encodedImage, inputByteOffset, inputByteOffset + 3)
            local packedBase64Value = (base64ByteLookup[encodedByte1] or 0) * 262144
                + (base64ByteLookup[encodedByte2] or 0) * 4096
                + (base64ByteLookup[encodedByte3] or 0) * 64
                + (base64ByteLookup[encodedByte4] or 0)
            local decodedByte1, decodedByte2, decodedByte3 =
                math.floor(packedBase64Value / 65536) % 256,
                math.floor(packedBase64Value / 256) % 256,
                packedBase64Value % 256
            if encodedByte3 == 61 then
                buffer.writeu8(decodedImageBuffer, outputByteOffset, decodedByte1)
                outputByteOffset += 1
            elseif encodedByte4 == 61 then
                buffer.writeu16(decodedImageBuffer, outputByteOffset, decodedByte1 + decodedByte2 * 256)
                outputByteOffset += 2
            elseif outputByteOffset + 3 < buffer.len(decodedImageBuffer) then
                buffer.writeu32(
                    decodedImageBuffer,
                    outputByteOffset,
                    decodedByte1 + decodedByte2 * 256 + decodedByte3 * 65536
                )
                outputByteOffset += 3
            else
                buffer.writeu16(decodedImageBuffer, outputByteOffset, decodedByte1 + decodedByte2 * 256)
                buffer.writeu8(decodedImageBuffer, outputByteOffset + 2, decodedByte3)
                outputByteOffset += 3
            end
            if inputByteOffset % 32768 == 1 and task and task.wait and os.clock() - lastYieldTime >= 0.008 then
                task.wait()
                lastYieldTime = os.clock()
            end
        end
        assert(outputByteOffset == buffer.len(decodedImageBuffer), "Aster: invalid brand image data")
        return buffer.tostring(decodedImageBuffer)
    end
    function brandAssets.asset(assetKey)
        if brandAssetCache[assetKey] ~= nil then
            return brandAssetCache[assetKey]
        end
        local assetLoaded, assetUri = pcall(function()
            if type(writefile) ~= "function" or type(getcustomasset) ~= "function" then
                return ""
            end
            local brandImagePath = "aster-jade-v2-" .. assetKey .. ".png"
            if not isfile or not isfile(brandImagePath) then
                writefile(brandImagePath, decodeBrandImageBase64(brandImagesBase64[assetKey]))
            end
            return getcustomasset(brandImagePath)
        end)
        brandAssetCache[assetKey] = assetLoaded and assetUri or ""
        return brandAssetCache[assetKey]
    end
    function brandAssets.draw(markParent, markPosition, markSize, markColor, markZIndex)
        local brandMarkImage = Instance.new("ImageLabel")
