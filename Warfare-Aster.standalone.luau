        end
        local windowFitToScreenSize = self.Root.Size

        local windowFitToScreenUiScale = (self._uiScale or 1)
            * (self._adaptive ~= false and flowLibrary._adaptiveFactor(windowFitToScreenAbsoluteSize) or 1)
        local windowFitToScreenMinimum = math.min(
            windowFitToScreenUiScale,
            (windowFitToScreenAbsoluteSize.X - 24) / math.max(windowFitToScreenSize.X.Offset, 1),
            (windowFitToScreenAbsoluteSize.Y - 24) / math.max(windowFitToScreenSize.Y.Offset, 1)
        )
        self._fitScale = math.max(windowFitToScreenMinimum, 0.1)
        if self._introDone and self.Open then
            if windowFitToScreenValue then
