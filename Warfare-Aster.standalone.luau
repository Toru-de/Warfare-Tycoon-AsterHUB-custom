        end)
        controlConfigManagerStateValue3._listeners = controlConfigManagerStateValue3._listeners or {}
        table.insert(controlConfigManagerStateValue3._listeners, controlConfigManagerOnConfigChanged)

        updateControlConfigManagerState2()
        return controlConfigManagerItems
    end

