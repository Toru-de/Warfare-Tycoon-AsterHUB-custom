                windowTabIcon3.ImageTransparency = 0.4
            end
            tab._icon = windowTabIcon3
        end
        tab._label = createTextLabel({
            Position = UDim2.fromOffset(2, windowTabIcon2 and 31 or 0),
            Size = UDim2.new(1, -4, windowTabIcon2 and 0 or 1, windowTabIcon2 and 14 or 0),
            Text = tab.Name,
            TextSize = 12,
            TextColor3 = themeColors.Muted,
            TextXAlignment = Enum.TextXAlignment.Center,
            Parent = windowTabButton,
        })

        local windowTabPage = createInstance("Frame", {
            Name = tab.Name,
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            Visible = false,
            Parent = self.Content,
        })
        tab._page = windowTabPage
        local windowTabTitleX = 24
        if windowTabIcon2 then
            local windowTabLeadingIcon = createLeadingIcon(
                windowTabPage,
                windowTabSuppliedOptions.Icon,
                themeColors.Accent,
                UDim2.new(0, 24, 0, 32)
            )
            windowTabLeadingIcon.Size = UDim2.fromOffset(20, 20)
            windowTabTitleX = 54
        end
        tab._titleX = windowTabTitleX
        tab._title = createTextLabel({
            Position = UDim2.fromOffset(windowTabTitleX, 20),
            Size = UDim2.new(1, -windowTabTitleX, 0, 24),
            Text = windowTabSuppliedOptions.PageTitle or tab.Name,
            TextSize = 22,
            Parent = windowTabPage,
        })
        if windowTabSuppliedOptions.Desc then
            tab._desc = createTextLabel({
                Position = UDim2.fromOffset(windowTabTitleX, 44),
                Size = UDim2.new(1, -windowTabTitleX, 0, 16),
                Text = windowTabSuppliedOptions.Desc,
                TextSize = 13,
                FontFace = fontFaces.Regular,
                TextColor3 = themeColors.Muted,
                Parent = windowTabPage,
            })
        end
        local windowTabHeaderBottom = windowTabSuppliedOptions.Desc and 70 or 58
        tab._headerBottom = windowTabHeaderBottom
        tab._iconName = windowTabSuppliedOptions.Icon
        createConfigScrollFrame(
            tab,
            windowTabPage,
            windowTabHeaderBottom,
            windowTabSuppliedOptions.Icon or "layout-grid",
            windowTabSuppliedOptions.EmptyText or "Nothing here yet"
        )

        local windowTabUIScale = createInstance("UIScale", { Parent = windowTabButton })
        local function updateWindowTabState()
            tweenProperties(windowTabUIScale, { Scale = 1 }, 0.35, Enum.EasingStyle.Back)
        end
        windowTabButton.MouseEnter:Connect(function()
            if self.CurrentTab ~= tab and not isTouchInput() then
                tweenProperties(windowTabButton, { BackgroundTransparency = 0.4 }, 0.12)
                tweenProperties(windowTabStroke, { Transparency = 0.5 }, 0.12)
            end
        end)
        windowTabButton.MouseLeave:Connect(function()
            updateWindowTabState()
            if self.CurrentTab ~= tab then
                tweenProperties(windowTabButton, { BackgroundTransparency = 1 }, 0.2)
                tweenProperties(windowTabStroke, { Transparency = 1 }, 0.2)
            end
        end)
        windowTabButton.MouseButton1Down:Connect(function()
            tweenProperties(windowTabUIScale, { Scale = 0.94 }, 0.12)
        end)
        windowTabButton.MouseButton1Up:Connect(updateWindowTabState)
        local windowTabStateValue = trackDragClickSuppression(windowTabButton, function()
            return self.TabList
        end)
        windowTabButton.MouseButton1Click:Connect(function()
            updateWindowTabState()
            if windowTabStateValue() then
                self:SelectTab(tab)
            end
        end)
        tab._stroke = windowTabStroke
        self:_fitTitle(tab)

        if not self._introDone then
            windowTabButton.Visible = false
        end
        table.insert(self.Tabs, tab)
        if #self.Tabs == 1 then
            task.defer(function()
                if not self.CurrentTab then
                    self:SelectTab(tab)
