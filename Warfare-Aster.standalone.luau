    function WindowMethods:_fitToScreen(windowFitToScreenValue)
        local windowFitToScreenAbsoluteSize = self.Gui.AbsoluteSize
        if windowFitToScreenAbsoluteSize.X == 0 or windowFitToScreenAbsoluteSize.Y == 0 then
