    local function getLucideIconRegistry()
        local getLucideIconRegistryItems = {}
        for getLucideIconRegistryKey, getLucideIconRegistryItem in ipairs(_AsterIconLibrary.ListIcons()) do
            getLucideIconRegistryItems[getLucideIconRegistryItem] =
                _AsterIconLibrary.GetIconData(getLucideIconRegistryItem)
        end
        setmetatable(getLucideIconRegistryItems, {
            __index = function(getLucideIconRegistryValue, getLucideIconRegistryArgument)
                return _AsterIconLibrary.GetIconData(getLucideIconRegistryArgument)
                    or _AsterIconLibrary.GetIconData("circle")
            end,
        })
        return { Icons = getLucideIconRegistryItems }
    end

    local fontDownloadSources = {
        ValleySans = {
            Regular = "https://raw.githubusercontent.com/HelsinkiTypeStudio/valley-sans/main/fonts/ttf/ValleySans-Regular.ttf",
            Medium = "https://raw.githubusercontent.com/HelsinkiTypeStudio/valley-sans/main/fonts/ttf/ValleySans-Medium.ttf",
            SemiBold = "https://raw.githubusercontent.com/HelsinkiTypeStudio/valley-sans/main/fonts/ttf/ValleySans-SemiBold.ttf",
        },
    }

    local fontWeightMetadata = {
        Regular = { 400, Enum.FontWeight.Regular },
        Medium = { 500, Enum.FontWeight.Medium },
        SemiBold = { 600, Enum.FontWeight.SemiBold },
        Bold = { 700, Enum.FontWeight.Bold },
    }

    function flowLibrary:LoadFont(loadFontSuppliedOptions)
        loadFontSuppliedOptions = normalizeOptions(loadFontSuppliedOptions, {})
        if type(writefile) ~= "function" or type(isfile) ~= "function" or typeof(getcustomasset) ~= "function" then
            warn("[Aster UI] custom fonts need writefile, isfile and getcustomasset")
            return false
        end
        local loadFontName = loadFontSuppliedOptions.Name or "CustomFont"
        local loadFontWeights = loadFontSuppliedOptions.Weights or fontDownloadSources[loadFontName]
        if type(loadFontWeights) ~= "table" then
            warn("[Aster UI] no font weights for " .. loadFontName)
            return false
        end
        local loadFontFolder = loadFontSuppliedOptions.Folder or "AirFlowFonts"
        pcall(function()
            if type(isfolder) == "function" and type(makefolder) == "function" and not isfolder(loadFontFolder) then
                makefolder(loadFontFolder)
            end
        end)
        local loadFontItems = {}
        for loadFontKey, loadFontItem in pairs(loadFontWeights) do
            local loadFontFontWeightMetadataEntry = fontWeightMetadata[loadFontKey]
            if loadFontFontWeightMetadataEntry then
                local loadFontFolder2 = loadFontFolder .. "/" .. loadFontName .. "-" .. loadFontKey .. ".ttf"
                local loadFontEnabled = true
                if not isfile(loadFontFolder2) then
                    loadFontEnabled = pcall(function()
                        writefile(loadFontFolder2, game:HttpGet(loadFontItem))
                    end)
                end
                if loadFontEnabled then
                    table.insert(
                        loadFontItems,
                        {
                            name = loadFontKey,
                            weight = loadFontFontWeightMetadataEntry[1],
                            style = "normal",
                            assetId = getcustomasset(loadFontFolder2),
                        }
                    )
                else
                    warn("[Aster UI] could not download " .. loadFontKey .. " weight of " .. loadFontName)
                end
            end
        end
        if #loadFontItems == 0 then
            return false
        end
        local loadFontFolder3 = loadFontFolder .. "/" .. loadFontName .. ".json"
        local loadFontSucceeded = pcall(function()
            writefile(loadFontFolder3, httpService:JSONEncode({ name = loadFontName, faces = loadFontItems }))
        end)
        if not loadFontSucceeded then
            return false
        end
        local loadFontStateValue = getcustomasset(loadFontFolder3)
        local function resolveFontWeight(resolveFontWeightValue, resolveFontWeightArgument)
            local resolveFontWeightFontWeightMetadataEntry = fontWeightMetadata[resolveFontWeightValue]
            if resolveFontWeightFontWeightMetadataEntry and loadFontWeights[resolveFontWeightValue] then
                return Font.new(loadFontStateValue, resolveFontWeightFontWeightMetadataEntry[2])
            end
            return resolveFontWeightArgument
        end
        flowLibrary.Fonts.Regular = resolveFontWeight("Regular", flowLibrary.Fonts.Regular)
        flowLibrary.Fonts.Medium = resolveFontWeight("Medium", resolveFontWeight("Regular", flowLibrary.Fonts.Medium))
        flowLibrary.Fonts.Bold = resolveFontWeight("SemiBold", resolveFontWeight("Bold", flowLibrary.Fonts.Bold))
        return true
    end

    function flowLibrary:PreloadIcons()
        return getLucideIconRegistry() ~= false
    end

    local function normalizeAssetUri(normalizeAssetUriAssetSource)
        if type(normalizeAssetUriAssetSource) == "number" then
            return "rbxassetid://" .. string.format("%.0f", normalizeAssetUriAssetSource)
        end
        if type(normalizeAssetUriAssetSource) == "string" then
            if normalizeAssetUriAssetSource:match("^%d+$") then
                return "rbxassetid://" .. normalizeAssetUriAssetSource
            end
            if
                normalizeAssetUriAssetSource:find("^rbxassetid://")
                or normalizeAssetUriAssetSource:find("^rbxasset://")
                or normalizeAssetUriAssetSource:find("^rbxthumb://")
                or normalizeAssetUriAssetSource:find("^http")
            then
                return normalizeAssetUriAssetSource
            end
        end
        return nil
    end

    local function resolveIconSource(resolveIconSourceIconSource)
        if typeof(resolveIconSourceIconSource) == "table" then
            return normalizeAssetUri(resolveIconSourceIconSource.Image) or resolveIconSourceIconSource.Image,
                resolveIconSourceIconSource.RectOffset,
                resolveIconSourceIconSource.RectSize,
                true,
