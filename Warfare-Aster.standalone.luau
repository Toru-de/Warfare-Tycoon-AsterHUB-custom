        end
        local disclaimerAcceptedText = tostring(disclaimerAcceptedValue) .. "/disclaimers.txt"
        local disclaimerAcceptedSucceeded, disclaimerAcceptedResult = pcall(function()
            return isfile(disclaimerAcceptedText) and readfile(disclaimerAcceptedText) or ""
        end)
        if not disclaimerAcceptedSucceeded or type(disclaimerAcceptedResult) ~= "string" then
            return false
        end
        for disclaimerAcceptedGmatch in disclaimerAcceptedResult:gmatch("[^\r\n]+") do
            if disclaimerAcceptedGmatch == disclaimerAcceptedArgument then
                return true
            end
        end
        return false
    end

    function executorNoticeStorage.AcceptDisclaimer(acceptDisclaimerValue, acceptDisclaimerArgument)
        if executorNoticeStorage.DisclaimerAccepted(acceptDisclaimerValue, acceptDisclaimerArgument) then
