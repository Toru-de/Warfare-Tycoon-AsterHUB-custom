    end)
    task.spawn(function()
        while running do
            statusLabel:Set(string.format("Characters: %d\nAssisted shots: %d\nNetwork synchronized: %d\nInstant rays / contacts: %d / %d\nErrors: %d", stats.targets, stats.assisted, stats.synced, stats.instantRays, stats.instantContacts, stats.errors))
            targetLabel:Set(selected and ((selected.player and selected.player.DisplayName or selected.model.Name) .. "\n" .. settings.AimPart) or "Waiting for a visible target inside FOV")
            local extendedState=extensionStatus()
