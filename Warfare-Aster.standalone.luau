        if acceptDisclaimerResult ~= "" and not acceptDisclaimerResult:match("\n$") then
            acceptDisclaimerResult ..= "\n"
        end
        return executorNoticeStorage.Write(
            acceptDisclaimerValue,
            acceptDisclaimerText,
            acceptDisclaimerResult .. acceptDisclaimerArgument .. "\n"
        )
    end

