    end

    function WindowMethods:_resolveBackground(windowResolveBackgroundValue)
        windowResolveBackgroundValue = self:_trimBackground(windowResolveBackgroundValue)
        local windowResolveBackgroundBackgroundPresetsEntry =
            flowLibrary.BackgroundPresets[windowResolveBackgroundValue]
        if windowResolveBackgroundBackgroundPresetsEntry then
            return windowResolveBackgroundBackgroundPresetsEntry
        end
        if windowResolveBackgroundValue:match("^%d+$") then
            return "rbxassetid://" .. windowResolveBackgroundValue
        end
        if
            windowResolveBackgroundValue:match("^rbxassetid://%d+")
            or windowResolveBackgroundValue:match("^rbxasset://")
            or windowResolveBackgroundValue:match("^rbxthumb://")
            or windowResolveBackgroundValue:match("^https?://www%.roblox%.com/asset")
        then
            return windowResolveBackgroundValue
        end
        local windowResolveBackgroundFunctionText = hasConfigFileApis() and typeof(getcustomasset) == "function"
        if windowResolveBackgroundValue:match("^https?://") then
            if not windowResolveBackgroundFunctionText then
                return nil, "web images need writefile and getcustomasset"
            end
            local windowResolveBackgroundMatchedText = windowResolveBackgroundValue:match("^[^?#]+")
                or windowResolveBackgroundValue
            local windowResolveBackgroundLowercaseText = (windowResolveBackgroundMatchedText:match("%.(%w+)$") or "png"):lower()
            if not flowLibrary._imageExtensions[windowResolveBackgroundLowercaseText] then
                windowResolveBackgroundLowercaseText = "png"
            end
            local windowResolveBackgroundSubstring = (windowResolveBackgroundMatchedText
                :gsub("^https?://", "")
                :gsub("[^%w]", "_")):sub(-60)
            local windowResolveBackgroundBackgroundFolder = self:_backgroundFolder() .. "/cache"
            local windowResolveBackgroundBackgroundFolder2 = windowResolveBackgroundBackgroundFolder
                .. "/"
                .. windowResolveBackgroundSubstring
                .. "_"
                .. #windowResolveBackgroundValue
                .. "."
                .. windowResolveBackgroundLowercaseText
            if not isfile(windowResolveBackgroundBackgroundFolder2) then
                local windowResolveBackgroundSucceeded, windowResolveBackgroundResult = pcall(function()
                    local windowResolveBackgroundRequest = (syn and syn.request) or http_request or request
                    if windowResolveBackgroundRequest then
                        local windowResolveBackgroundStateValue =
                            windowResolveBackgroundRequest({ Url = windowResolveBackgroundValue, Method = "GET" })
                        return windowResolveBackgroundStateValue and windowResolveBackgroundStateValue.Body
                    end
                    return game:HttpGet(windowResolveBackgroundValue, true)
                end)
                if
                    not windowResolveBackgroundSucceeded
                    or type(windowResolveBackgroundResult) ~= "string"
                    or #windowResolveBackgroundResult < 128
                then
                    return nil, "could not download the image"
                end
                local windowResolveBackgroundLowercaseText2 = windowResolveBackgroundResult:sub(1, 64):lower()
                if
                    windowResolveBackgroundLowercaseText2:find("<!doctype")
                    or windowResolveBackgroundLowercaseText2:find("<html")
                then
                    return nil, "that link is a web page, not an image"
                end
                ensureConfigFolder(windowResolveBackgroundBackgroundFolder)
                if not pcall(writefile, windowResolveBackgroundBackgroundFolder2, windowResolveBackgroundResult) then
                    return nil, "could not save the image"
                end
            end
            local windowResolveBackgroundSucceeded2, windowResolveBackgroundResult2 =
                pcall(getcustomasset, windowResolveBackgroundBackgroundFolder2)
            if
                windowResolveBackgroundSucceeded2
                and type(windowResolveBackgroundResult2) == "string"
                and windowResolveBackgroundResult2 ~= ""
            then
                return windowResolveBackgroundResult2
            end
            pcall(delfile, windowResolveBackgroundBackgroundFolder2)
            return nil, "the downloaded file is not an image"
        end

        if windowResolveBackgroundFunctionText then
            for windowResolveBackgroundKey, windowResolveBackgroundItem in ipairs({
                self:_backgroundFolder() .. "/" .. windowResolveBackgroundValue,
                windowResolveBackgroundValue,
            }) do
                if isfile(windowResolveBackgroundItem) then
                    local windowResolveBackgroundSucceeded3, windowResolveBackgroundResult3 =
                        pcall(getcustomasset, windowResolveBackgroundItem)
                    if
                        windowResolveBackgroundSucceeded3
                        and type(windowResolveBackgroundResult3) == "string"
                        and windowResolveBackgroundResult3 ~= ""
                    then
                        return windowResolveBackgroundResult3
                    end
                    return nil, "could not load " .. windowResolveBackgroundValue
                end
            end
        end
        return nil, "no image called " .. windowResolveBackgroundValue
    end

    function WindowMethods:SetBackground(windowSetBackgroundBackground)
        self._backgroundGeneration += 1
        local windowSetBackgroundBackgroundGeneration = self._backgroundGeneration
        local windowSetBackgroundTarget = self._backgroundImage
        windowSetBackgroundBackground = windowSetBackgroundBackground ~= false
                and self:_trimBackground(windowSetBackgroundBackground)
            or ""
        if windowSetBackgroundBackground == "" or windowSetBackgroundBackground == "None" then
            self.Background = nil
            tweenProperties(windowSetBackgroundTarget, { ImageTransparency = 1 }, 0.25)
            task.delay(0.25, function()
                if self._backgroundGeneration == windowSetBackgroundBackgroundGeneration then
                    windowSetBackgroundTarget.Visible = false
                    windowSetBackgroundTarget.Image = ""
                end
            end)
            self:SetTransparent(self.Transparent)
            return true
        end
        local windowSetBackgroundImage, windowSetBackgroundResolveBackground =
            self:_resolveBackground(windowSetBackgroundBackground)
        if self._backgroundGeneration ~= windowSetBackgroundBackgroundGeneration or self._destroyed then
            return false, "replaced by a newer background"
        end
        if not windowSetBackgroundImage then
            return false, windowSetBackgroundResolveBackground
        end
        self.Background = windowSetBackgroundBackground
        windowSetBackgroundTarget.Image = windowSetBackgroundImage
        windowSetBackgroundTarget.Visible = true
        tweenProperties(windowSetBackgroundTarget, { ImageTransparency = self.BackgroundTransparency }, 0.3)
        self:SetTransparent(self.Transparent)
        return true
    end

