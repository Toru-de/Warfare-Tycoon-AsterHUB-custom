                for setVisibleKey, setVisibleItem in ipairs(controlGroupboxContainer._items) do
                    if setVisibleItem._onHide then
                        setVisibleItem._onHide()
                    end
                    if setVisibleItem.Open and type(setVisibleItem.SetOpen) == "function" then
                        setVisibleItem:SetOpen(false)
                    end
                end
            end
            controlGroupboxFrame.Visible = setVisibleUserVisible
            groupboxWindow._controlsDirty = true
        end
        if not controlGroupboxContainer._userVisible then
            controlGroupboxFrame.Visible = false
        end
        function controlGroupboxContainer:Destroy()
            for destroyIndex = #controlGroupboxContainer._items, 1, -1 do
                local destroyItemsEntry = controlGroupboxContainer._items[destroyIndex]
                if type(destroyItemsEntry.Destroy) == "function" then
                    destroyItemsEntry:Destroy()
                end
            end
            local destroyParent = controlGroupboxContainer.Parent
            local destroyMatchIndex = table.find(destroyParent._groupboxes, controlGroupboxContainer)
            if destroyMatchIndex then
                table.remove(destroyParent._groupboxes, destroyMatchIndex)
            end
            controlGroupboxColumns.Counts[controlGroupboxSide] =
                math.max(controlGroupboxColumns.Counts[controlGroupboxSide] - 1, 0)
            groupboxWindow._controlsDirty = true
            controlGroupboxFrame:Destroy()
        end

        if groupboxOptions.Collapsed then
            updateControlGroupboxLayout(true, true)
        end
        return controlGroupboxContainer
    end

