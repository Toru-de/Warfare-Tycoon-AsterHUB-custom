    function brandAssets.background(backdropParent)
        local function createBrandInstance(brandClassName, brandProperties, brandParent)
            local brandInstance = Instance.new(brandClassName)
            for brandPropertyName, brandPropertyValue in pairs(brandProperties) do
                brandInstance[brandPropertyName] = brandPropertyValue
            end
            brandInstance.Parent = brandParent
