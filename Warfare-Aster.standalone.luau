        )

        for inlayIndex = 1, 3 do
            local inlayFrame = createBrandInstance(
                "Frame",
                {
                    Name = "Inlay" .. inlayIndex,
                    Position = UDim2.fromScale(0.63 + inlayIndex * 0.13, -0.25),
                    Size = UDim2.new(0, 74, 1.65, 0),
                    Rotation = 32,
                    BackgroundColor3 = Color3.fromRGB(132, 190, 143),
                    BackgroundTransparency = 0.95 - inlayIndex * 0.012,
                    BorderSizePixel = 0,
                    ZIndex = 0,
                },
                asterBackdropFrame
            )
            createBrandInstance(
                "UIStroke",
                { Color = Color3.fromRGB(168, 225, 179), Transparency = 0.89, Thickness = 1 },
                inlayFrame
            )
        end
        createBrandInstance(
            "Frame",
            {
                Name = "TopLight",
                Position = UDim2.fromOffset(14, 0),
                Size = UDim2.new(1, -28, 0, 1),
                BorderSizePixel = 0,
                BackgroundColor3 = Color3.fromRGB(176, 226, 170),
                BackgroundTransparency = 0.52,
                ZIndex = 0,
            },
            asterBackdropFrame
        )
        return asterBackdropFrame
    end
    return brandAssets
end)()

