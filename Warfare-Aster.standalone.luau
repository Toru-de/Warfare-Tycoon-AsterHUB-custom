            local function updateImportState()
                local updateImportStateImportConfig, updateImportStateImportConfig2 =
                    controlConfigManagerWindow:ImportConfig(importValue, importStateValue, true)
                if updateImportStateImportConfig then
                    controlConfigManagerStateValue6:Set("")
                    if importStateValue then
