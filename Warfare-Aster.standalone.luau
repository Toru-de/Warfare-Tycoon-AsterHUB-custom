    local function formatElapsedTime(formatElapsedTimeValue)
        formatElapsedTimeValue = math.max(math.floor(formatElapsedTimeValue), 0)
        local formatElapsedTimeRoundedValue = math.floor(formatElapsedTimeValue / 86400)
        local formatElapsedTimeRoundedValue2 = math.floor(formatElapsedTimeValue / 3600) % 24
        local formatElapsedTimeRoundedValue3 = math.floor(formatElapsedTimeValue / 60) % 60
        if formatElapsedTimeRoundedValue > 0 then
            return string.format("%dd %dh", formatElapsedTimeRoundedValue, formatElapsedTimeRoundedValue2)
        elseif formatElapsedTimeRoundedValue2 > 0 then
            return string.format("%dh %dm", formatElapsedTimeRoundedValue2, formatElapsedTimeRoundedValue3)
        elseif formatElapsedTimeRoundedValue3 > 0 then
            return string.format("%dm %ds", formatElapsedTimeRoundedValue3, formatElapsedTimeValue % 60)
        end
        return string.format("%ds", formatElapsedTimeValue)
    end

    local function normalizeExternalUrl(normalizeExternalUrlValue)
