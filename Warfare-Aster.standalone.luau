                    updateImportStateImportConfig and "Config imported" or "Import failed",
                    updateImportStateImportConfig and (importStateValue or "Applied to current settings")
                        or tostring(updateImportStateImportConfig2)
                )
            end
            if importDecodeConfig2.Folder and importDecodeConfig2.Folder ~= controlConfigManagerWindow.ConfigFolder then
                controlConfigManagerWindow:Confirm({
                    Title = "Different script",
                    Content = ("This config was made for %s. Import it anyway? Only matching settings are applied."):format(
