    local function normalizeThemeColor(normalizeThemeColorColor)
        if typeof(normalizeThemeColorColor) == "Color3" then
            return normalizeThemeColorColor
        elseif type(normalizeThemeColorColor) == "string" then
            local normalizeThemeColorMatchedText, normalizeThemeColorMatchedText2, normalizeThemeColorMatchedText3 =
                normalizeThemeColorColor:match("^%s*#?(%x%x)(%x%x)(%x%x)%s*$")
            if normalizeThemeColorMatchedText then
                return Color3.fromRGB(
                    tonumber(normalizeThemeColorMatchedText, 16),
                    tonumber(normalizeThemeColorMatchedText2, 16),
                    tonumber(normalizeThemeColorMatchedText3, 16)
                )
            end
        elseif type(normalizeThemeColorColor) == "table" then
            local normalizeThemeColorEntry, normalizeThemeColorEntry2, normalizeThemeColorEntry3 =
                normalizeThemeColorColor[1] or normalizeThemeColorColor.R,
                normalizeThemeColorColor[2] or normalizeThemeColorColor.G,
                normalizeThemeColorColor[3] or normalizeThemeColorColor.B
            if
                tonumber(normalizeThemeColorEntry)
                and tonumber(normalizeThemeColorEntry2)
                and tonumber(normalizeThemeColorEntry3)
            then
                return Color3.fromRGB(normalizeThemeColorEntry, normalizeThemeColorEntry2, normalizeThemeColorEntry3)
            end
        end
        return nil
    end

    local function formatThemeColorHex(formatThemeColorHexColor)
        return string.format(
            "#%02X%02X%02X",
            math.floor(formatThemeColorHexColor.R * 255 + 0.5),
            math.floor(formatThemeColorHexColor.G * 255 + 0.5),
            math.floor(formatThemeColorHexColor.B * 255 + 0.5)
        )
    end

    flowLibrary._toneTags = {}
    for key4, item4 in ipairs(themeColorKeys) do
        flowLibrary._toneTags[string.lower(item4)] = item4
    end

    function flowLibrary._color(colorValue)
        if type(colorValue) == "string" then
            local colorToneTagsEntry = flowLibrary._toneTags[string.lower(colorValue)]
            if colorToneTagsEntry then
                return themeColors[colorToneTagsEntry]
            end
        end
        return normalizeThemeColor(colorValue)
    end

    function flowLibrary._rich(richValue)
        richValue = tostring(richValue == nil and "" or richValue)
        if not string.find(richValue, "<", 1, true) then
            return richValue
        end
        return (
            string.gsub(richValue, "<(/?)(%a+%d*)>", function(richValue2, richArgument)
                local richToneTagsEntry = flowLibrary._toneTags[string.lower(richArgument)]
                if not richToneTagsEntry then
                    return nil
                end
                if richValue2 == "/" then
                    return "</font>"
                end
                return '<font color="' .. formatThemeColorHex(themeColors[richToneTagsEntry]) .. '">'
            end)
        )
    end

    function flowLibrary.Colorize(...)
        local colorizeItems = { ... }
        if colorizeItems[1] == flowLibrary then
            table.remove(colorizeItems, 1)
        end
        local colorizeText, colorizeItemsEntry =
            tostring(colorizeItems[1] == nil and "" or colorizeItems[1]), colorizeItems[2]
        local colorizeStringText = type(colorizeItemsEntry) == "string"
            and flowLibrary._toneTags[string.lower(colorizeItemsEntry)]
        if colorizeStringText then
            return "<" .. colorizeStringText .. ">" .. colorizeText .. "</" .. colorizeStringText .. ">"
        end
        local colorizeStateValue = normalizeThemeColor(colorizeItemsEntry)
        if not colorizeStateValue then
            return colorizeText
        end
        return '<font color="' .. formatThemeColorHex(colorizeStateValue) .. '">' .. colorizeText .. "</font>"
    end

    function flowLibrary:SetTheme(setThemeThemeName, setThemeArgument)
        if type(setThemeThemeName) == "string" then
            local setThemeThemePresetsEntry = flowLibrary.ThemePresets[setThemeThemeName]
            if not setThemeThemePresetsEntry then
                return false
            end
            flowLibrary.ThemeName = setThemeThemeName
            setThemeThemeName = setThemeThemePresetsEntry
        elseif type(setThemeThemeName) ~= "table" then
            return false
        end
        local setThemeEnabled = false
        for setThemeKey, setThemeItem in ipairs(themeColorKeys) do
            local setThemeStateValue = normalizeThemeColor(setThemeThemeName[setThemeItem])
            if setThemeStateValue and setThemeStateValue ~= themeColors[setThemeItem] then
                themeColors[setThemeItem] = setThemeStateValue
                setThemeEnabled = true
            end
        end
        if not setThemeEnabled then
            return true
        end
        refreshThemeColorLookup()
        cleanupThemeBindings()
        animateThemeTransition(setThemeArgument and 0 or 0.3)
        for setThemeKey2, setThemeItem2 in pairs(themeCallbacks) do
            if setThemeKey2.Parent then
                pcall(setThemeItem2)
            end
        end
        for setThemeKey3, setThemeItem3 in ipairs(flowLibrary._themeListeners) do
            pcall(setThemeItem3)
        end
        return true
    end

