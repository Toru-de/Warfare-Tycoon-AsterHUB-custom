    function flowLibrary._adaptiveFactor(adaptiveFactorPosition)
        if touchEnabled then
            return 1
        end
        local adaptiveFactorMinimum = math.min(adaptiveFactorPosition.X / 1920, adaptiveFactorPosition.Y / 1020)
        if adaptiveFactorMinimum > 0.9 and adaptiveFactorMinimum < 1.15 then
            return 1
        end
        return math.clamp(math.floor(adaptiveFactorMinimum * 20 + 0.5) / 20, 0.85, 1.75)
    end

