    flowLibrary.DensityModes = { Compact = 0.85, Default = 1, Comfortable = 1.45 }
    flowLibrary.Density = "Default"

    function flowLibrary._spaced(spacedValue, spacedArgument)
        if spacedValue <= 0 then
            return 0
        end
        return math.max(math.floor(spacedValue * spacedArgument + 0.5), spacedValue >= 8 and 8 or 1)
    end

    function flowLibrary._space(spaceValue, spaceArgument)
        local spaceDensityModesEntry = flowLibrary.DensityModes[flowLibrary.Density] or 1
        if spaceValue:IsA("UIListLayout") or spaceValue:IsA("UIGridLayout") then
            spaceValue:SetAttribute("Space", spaceArgument)
            spaceValue.Padding = UDim.new(0, flowLibrary._spaced(spaceArgument, spaceDensityModesEntry))
        elseif spaceValue:IsA("UIPadding") then
            spaceValue:SetAttribute("SpaceL", spaceArgument[1])
            spaceValue:SetAttribute("SpaceR", spaceArgument[2])
            spaceValue:SetAttribute("SpaceT", spaceArgument[3])
            spaceValue:SetAttribute("SpaceB", spaceArgument[4])
            spaceValue.PaddingLeft = UDim.new(0, math.floor(spaceArgument[1] * math.sqrt(spaceDensityModesEntry) + 0.5))
            spaceValue.PaddingRight =
                UDim.new(0, math.floor(spaceArgument[2] * math.sqrt(spaceDensityModesEntry) + 0.5))
            spaceValue.PaddingTop = UDim.new(0, flowLibrary._spaced(spaceArgument[3], spaceDensityModesEntry))
            spaceValue.PaddingBottom = UDim.new(0, flowLibrary._spaced(spaceArgument[4], spaceDensityModesEntry))
        end
        return spaceValue
    end

    function flowLibrary:SetDensity(setDensityDensity)
        if type(setDensityDensity) == "string" then
            for setDensityKey in pairs(flowLibrary.DensityModes) do
                if setDensityKey:lower() == setDensityDensity:lower() then
                    setDensityDensity = setDensityKey
                    break
                end
            end
        end
        if not flowLibrary.DensityModes[setDensityDensity] then
            setDensityDensity = "Default"
        end
        flowLibrary.Density = setDensityDensity
        for setDensityKey2, setDensityWindow in ipairs(flowLibrary.Windows) do
            if setDensityWindow.Gui and setDensityWindow.Gui.Parent then
                for setDensityKey3, setDensityItem in ipairs(setDensityWindow.Gui:GetDescendants()) do
                    local setDensityAttributeValue = setDensityItem:GetAttribute("Space")
                    if setDensityAttributeValue then
                        flowLibrary._space(setDensityItem, setDensityAttributeValue)
                    elseif setDensityItem:GetAttribute("SpaceL") then
                        flowLibrary._space(setDensityItem, {
                            setDensityItem:GetAttribute("SpaceL"),
                            setDensityItem:GetAttribute("SpaceR"),
                            setDensityItem:GetAttribute("SpaceT"),
                            setDensityItem:GetAttribute("SpaceB"),
                        })
                    end
                end
            end
        end
        return setDensityDensity
    end

