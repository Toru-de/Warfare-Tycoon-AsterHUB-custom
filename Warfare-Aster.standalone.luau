        end
        if not holdingRPG and overlays and selected and aimActive() and allowed(selected) then
            local pt, visible = camera:WorldToViewportPoint(aimPart(selected).Position)
            if visible then targetDot.Position = Vector2.new(pt.X, pt.Y); targetDot.Color = settings.TargetColor; targetDot.Visible = true end
        end
        local count = 0
        for model, record in records do
            hide(record)
            if not model.Parent or record.humanoid.Health <= 0 then removeRecord(model)
            elseif allowed(record) then
                count += 1
                local distance = (record.root.Position - camera.CFrame.Position).Magnitude
                if overlays and settings.ESP and distance <= settings.MaxDistance then
                    local color = not holdingRPG and selected == record and settings.TargetColor or (record.player and settings.PlayerColor or settings.NPCColor)
                    local point, onScreen = camera:WorldToViewportPoint(record.root.Position)
                    if onScreen and point.Z > 0 then
                        record.highlight.Enabled = settings.Chams
                        record.highlight.FillColor, record.highlight.OutlineColor = color, color
                        record.highlight.FillTransparency = settings.ChamsOpacity
                        local top = record.head.Position + Vector3.new(0, record.head.Size.Y * 0.65, 0)
                        local bottom = record.root.Position - Vector3.new(0, record.humanoid.HipHeight + record.root.Size.Y / 2 + 0.15, 0)
                        local upper = camera:WorldToViewportPoint(top)
                        local lower = camera:WorldToViewportPoint(bottom)
                        local height = math.abs(lower.Y - upper.Y)
                        local width = height * 0.54
                        if height > 4 and height < view.Y * 3 and upper.Z > 0 and lower.Z > 0 then
                            local x, y = math.floor((upper.X + lower.X) / 2 - width / 2), math.floor(math.min(upper.Y, lower.Y))
                            local right, base, cut = x + width, y + height, math.min(width * 0.3, 18)
                            if settings.Boxes then
                                local segments = {
                                    {x,y,x+cut,y},{x,y,x,y+cut},{right-cut,y,right,y},{right,y,right,y+cut},
                                    {x,base,x+cut,base},{x,base-cut,x,base},{right-cut,base,right,base},{right,base-cut,right,base},
                                }
                                for i, s in segments do line(record.lines[i], Vector2.new(s[1],s[2]), Vector2.new(s[3],s[4]), color) end
                            end
                            if settings.Names then
                                record.name.Text = record.player and record.player.DisplayName or ("[NPC] " .. model.Name)
                                record.name.Position, record.name.Color, record.name.Visible = Vector2.new(x + width / 2, y - 18), color, true
                            end
                            if settings.Distance then
                                record.info.Text = string.format("%d studs", math.floor(distance))
                                record.info.Position, record.info.Color, record.info.Visible = Vector2.new(x + width / 2, base + 4), Color3.fromRGB(220, 229, 239), true
                            end
                            if settings.Health then
                                local health = math.clamp(record.humanoid.Health / math.max(record.humanoid.MaxHealth, 1), 0, 1)
                                record.healthBack.Position, record.healthBack.Size = Vector2.new(x - 7, y - 1), Vector2.new(4, height + 2)
                                record.healthFill.Position, record.healthFill.Size = Vector2.new(x - 6, y + height * (1 - health)), Vector2.new(2, height * health)
                                record.healthFill.Color = Color3.fromRGB(255, 88, 104):Lerp(Color3.fromRGB(71, 230, 157), health)
                                record.healthBack.Visible, record.healthFill.Visible = true, true
                            end
                        end
                        if settings.Skeleton then
                            for _, bone in record.bones do
                                local a, b = model:FindFirstChild(bone.a), model:FindFirstChild(bone.b)
                                if a and b and a:IsA("BasePart") and b:IsA("BasePart") then
                                    local ap, av = camera:WorldToViewportPoint(a.Position)
                                    local bp, bv = camera:WorldToViewportPoint(b.Position)
                                    if av and bv then bone.line.From = Vector2.new(ap.X,ap.Y); bone.line.To = Vector2.new(bp.X,bp.Y); bone.line.Color = color; bone.line.Visible = true end
                                end
                            end
                        end
                    elseif settings.Arrows then
                        local localPosition = camera.CFrame:PointToObjectSpace(record.root.Position)
                        local direction = Vector2.new(localPosition.X, -localPosition.Y)
                        if direction.Magnitude < 0.001 then direction = Vector2.new(0, 1) end
                        direction = direction.Unit
                        local edge = center + direction * math.min((view.X / 2 - 35) / math.max(math.abs(direction.X), 0.001), (view.Y / 2 - 45) / math.max(math.abs(direction.Y), 0.001))
                        local side = Vector2.new(-direction.Y, direction.X)
                        record.arrow.PointA, record.arrow.PointB, record.arrow.PointC = edge + direction * 9, edge - direction * 7 + side * 5, edge - direction * 7 - side * 5
                        record.arrow.Color, record.arrow.Visible = color, true
                    end
                end
            end
        end
        stats.targets = count
        renderVehicles(camera,overlays)
    end)

    installShotHook = function()
        local character = localPlayer.Character
        if not running or not character then return end
        -- GC also contains hookfunction's original clones after each reload.
        -- Resolve the exact closure held by the live script's Shoot function.
        local candidate: any = activeCreateBullet()
        if type(candidate) ~= "function" or candidate == fireFunction then return end
        local candidateUp: any = debug.getupvalues(candidate)
        if candidateUp[6] ~= character or candidateUp[17] ~= localPlayer then return end
        if fireFunction then
            pcall(restorefunction, fireFunction)
            table.clear(hooked)
            fireFunction = nil
        end
        local originalCreate
        originalCreate = hookfunction(candidate, function(ads)
            stats.hookCalls += 1
            if not running then return originalCreate(ads) end
            local ok, shot = pcall(planShot, originalCreate, ads)
            if not ok then
                stats.errors += 1
                stats.lastError = tostring(shot)
                warn("[Aster Warfare] aim", shot)
                return originalCreate(ads)
            end
            if not shot then return originalCreate(ads) end
            local sent, problem = pcall(function()
                if shot.instant then
                    -- Register the normal shot before its hit callbacks dispatch damage.
                    shot.events:FindFirstChild("ServerBullet"):FireServer(shot.origin, shot.direction, shot.serializer.ToArray(shot.data))
                    stats.synced += 1
                    if shot.extended then queueExtendedBullet(shot) else resolveInstant(shot) end
                    stats.assisted += 1
                    if shot.rpg then rpg.assisted+=1 end
                else
                    shot.shoot.fire(localPlayer, shot.origin, shot.direction, shot.data)
                    stats.assisted += 1
                    shot.events:FindFirstChild("ServerBullet"):FireServer(shot.origin, shot.direction, shot.serializer.ToArray(shot.data))
                    stats.synced += 1
                    if shot.rpg then rpg.assisted+=1 end
                end
            end)
            if not sent then stats.errors += 1; stats.lastError = tostring(problem); warn("[Aster Warfare] shot", problem) end
            return nil
        end)
        fireFunction, shootOriginal, hookCharacter = candidate, originalCreate, character
        table.insert(hooked, candidate)
        local up: any = debug.getupvalues(originalCreate)
        if up[16] and type(up[16].fire) == "function" then
            local ok = pcall(function()
                for _, value in debug.getupvalues(up[16].fire) do
                    if typeof(value) == "Vector3" and value.Y < 0 and value.X == 0 and value.Z == 0 then baseAcceleration = value end
                end
            end)
            if not ok then baseAcceleration = Vector3.new(0, -workspace.Gravity / 2, 0) end
        end
    end
    installShotHook()
    control.OnInvoke = function(action)
        if action == "Unload" then shutdown(); return true end
        if action == "Status" then
            return {running = running, targets = stats.targets, seen = stats.seen, assisted = stats.assisted, synced = stats.synced, errors = stats.errors,
                target = selected and selected.model.Name, drawings = drawingCount, gravity = baseAcceleration, silent = settings.Silent,
                hookCalls = stats.hookCalls, attached = fireFunction ~= nil, mode = "ACS Shoot -> CreateBullet",
                instant = settings.InstantBullets, instantRays = stats.instantRays, instantContacts = stats.instantContacts,
                lastError = stats.lastError}
        end
        if action == "HookTest" then
            local up: any = shootOriginal and debug.getupvalues(shootOriginal) or {}
            return {passed = fireFunction ~= nil and activeCreateBullet() == fireFunction
                and up[6] == localPlayer.Character and up[17] == localPlayer, binding = "ACS_Framework.Shoot[14]"}
        end
        if action == "ShotDiagnostics" then return stats.lastShot end
        if action == "InstantDiagnostics" then return stats.lastInstant end
        if action == "ExtensionStatus" then return extensionStatus() end
        if action == "ExtensionDisabledTest" then
            if extensionActive() then return {passed=false,reason="Disable Extended hits before this test"} end
            local before=extension.requests
            local selections=extension.selections or 0
            local candidate=chooseExtendedTarget(Vector3.zero)
            local state=extensionStatus()
            return {passed=candidate==nil and before==extension.requests and selections==(extension.selections or 0)
                and not state.hooked and not state.worker and state.pending==0,requests=state.requests,selections=state.selections}
        end
        if action == "InstantReady" then return {ready=type(instantDetector)=="table" and type(instantDetector.canRayPierce)=="function"
            and type(instantDetector.onHit)=="function",enabled=settings.InstantBullets,manualAimSupported=true} end
        if action == "AviationStatus" then return aircraftStatus() end
        if action == "AviationTest" then return aircraftTests() end
        if action == "RocketDiagnostics" then return aviation.lastShot end
        if action == "VehicleStatus" then return vehicleStatus() end
        if action == "RPGDiagnostics" then return rpg.lastShot end
        if action == "VehicleTargets" then
            local out={}
            for model,record in vehicles do if #out<40 then table.insert(out,{name=model.Name,kind="Vehicle",health=record.vehicleHealth.Value,own=model==localVehicle()}) end end
            return out
        end
        if action == "Minimize" then window:Minimize(); return true end
        if action == "BallisticsTest" then
            local results = {}
            for _, sample in {
                {position=Vector3.new(0,0,-100), velocity=Vector3.zero, speed=700},
                {position=Vector3.new(100,20,-600), velocity=Vector3.new(40,0,10), speed=900},
                {position=Vector3.new(0,0,-25), velocity=Vector3.new(-70,8,0), speed=300},
                {position=Vector3.new(0,0,-1000),velocity=Vector3.zero,speed=400},
                {position=Vector3.new(250,20,-600),velocity=Vector3.new(40,0,10),speed=400},
            } do
                local direction, t = intercept(Vector3.zero, sample.position, sample.velocity, sample.speed, baseAcceleration, 15)
                local errorDistance = direction and (direction * sample.speed * t + baseAcceleration * (0.5*t*t) - (sample.position + sample.velocity*t)).Magnitude or math.huge
                table.insert(results, {time=t,errorStuds=errorDistance,passed=errorDistance<0.1})
            end
            return results
        end
        return nil
    end
    task.spawn(function()
        while running do
            local camera = workspace.CurrentCamera
            if camera and settings.Silent and not rpgEquipped() then selected = chooseTarget(camera.CFrame.Position) else selected = nil end
            for id, plan in plans do if os.clock() - plan.time > 2 then plans[id] = nil end end
