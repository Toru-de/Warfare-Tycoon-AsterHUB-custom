                        windowFeatureGroupsItems2[string.lower(updateWindowFeatureGroupsStateValue)] = windowFeatureGroupsItems2[string.lower(
                            updateWindowFeatureGroupsStateValue
                        )] or updateWindowFeatureGroupsStateNameData
                    end
                    local function updateWindowFeatureGroupsText(
                        updateWindowFeatureGroupsTextControl,
                        updateWindowFeatureGroupsTextArgument,
                        updateWindowFeatureGroupsTextArgument2
                    )
                        if
                            updateWindowFeatureGroupsTextControl._destroyed
                            or not self._featureKinds[updateWindowFeatureGroupsTextControl._type]
                            or (
