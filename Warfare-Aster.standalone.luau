    local function createTransitionGhost(
        createTransitionGhostWindow,
        createTransitionGhostPosition,
        createTransitionGhostPosition2,
        createTransitionGhostArgument
    )
        if createTransitionGhostWindow._ghost then
            createTransitionGhostWindow._ghost:Destroy()
        end
        local createTransitionGhostFrame = createInstance("Frame", {
            Position = UDim2.fromOffset(createTransitionGhostPosition.X, createTransitionGhostPosition.Y),
            Size = UDim2.fromOffset(createTransitionGhostPosition2.X, createTransitionGhostPosition2.Y),
            BackgroundColor3 = themeColors.Background,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ZIndex = 29,
