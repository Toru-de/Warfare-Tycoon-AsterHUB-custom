                if isValidConfigName(importDecodeConfig2.Name) then
                    importStateValue = importDecodeConfig2.Name
                    local importOffset = 2
                    while controlConfigManagerWindow:ConfigExists(importStateValue) do
                        importStateValue = ("%s (%d)"):format(importDecodeConfig2.Name, importOffset)
                        importOffset += 1
