    function WindowMethods:_buildBackdrop(windowBuildBackdropValue)
        local windowBuildBackdropBackdrop = createInstance("Frame", {
            Name = "Backdrop",
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            Visible = false,
            ZIndex = 0,
            Parent = self.Gui,
        })
        local windowBuildBackdropBackdropTintFrame = createInstance("Frame", {
            Size = UDim2.fromScale(1, 1),
            BackgroundColor3 = Color3.new(0, 0, 0),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ZIndex = 0,
            Parent = windowBuildBackdropBackdrop,
        })

        createInstance("UIGradient", {
            Rotation = 90,
            Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0),
                NumberSequenceKeypoint.new(0.5, 0.3),
                NumberSequenceKeypoint.new(1, 0),
            }),
            Parent = windowBuildBackdropBackdropTintFrame,
        })

        local windowBuildBackdropBackdropHeat = createInstance("Frame", {
            AnchorPoint = Vector2.new(0, 1),
            Position = UDim2.fromScale(0, 1),
            Size = UDim2.fromScale(1, 0.5),
            BackgroundColor3 = Color3.fromRGB(255, 60, 15),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ZIndex = 1,
            Parent = windowBuildBackdropBackdrop,
        })
        createInstance("UIGradient", {
            Rotation = 90,
            Transparency = NumberSequence.new(1, 0),
            Parent = windowBuildBackdropBackdropHeat,
        })

        local windowBuildBackdropWeatherField = createInstance("Frame", {
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            ClipsDescendants = true,
            ZIndex = 2,
            Parent = windowBuildBackdropBackdrop,
        })
        windowBuildBackdropBackdropHeat.Parent = windowBuildBackdropWeatherField
        self._backdrop = windowBuildBackdropBackdrop
        self._backdropTintFrame = windowBuildBackdropBackdropTintFrame
        self._backdropHeat = windowBuildBackdropBackdropHeat
        self._weatherField = windowBuildBackdropWeatherField
        self._weatherParticles = {}
        self._backdropFade = 0
        self._weatherKick = 0
        self._backdropShown = false
        self._backdropEnabled = windowBuildBackdropValue.Enabled ~= false
        self._backdropTint = math.clamp(tonumber(windowBuildBackdropValue.Tint) or 0.45, 0, 1)
        self._backdropDim = windowBuildBackdropValue.Dim ~= false
        self._dimLevel = self._backdropDim and 1 or 0
        self._weatherDensity = math.clamp(tonumber(windowBuildBackdropValue.Density) or 1, 0, 3)
        self._weatherSpeed = math.clamp(tonumber(windowBuildBackdropValue.Speed) or 1, 0.1, 3)
        self.Weather = normalizeParticleEffect(
            windowBuildBackdropValue.Weather == nil and "Snow" or windowBuildBackdropValue.Weather
        )
        self.WeatherMode = "Screen"
        self:SetWeatherMode(windowBuildBackdropValue.Mode)
        self:_rebuildWeather()
        table.insert(self._frameSteps, function(windowBuildBackdropValue2)
            self:_stepBackdrop(windowBuildBackdropValue2)
        end)
    end

    function WindowMethods:_weatherSize()
        if self.WeatherMode == "UI" then
            return Vector2.new(self.Root.Size.X.Offset, self.Root.Size.Y.Offset)
        end
        return self.Gui.AbsoluteSize
    end

    function WindowMethods:_rebuildWeather()
        for windowRebuildWeatherKey, windowRebuildWeatherItem in ipairs(self._weatherParticles) do
            windowRebuildWeatherItem.Label:Destroy()
        end
        self._weatherParticles = {}
        local windowRebuildWeatherRainDataEntry = rainData[self.Weather]
        if not windowRebuildWeatherRainDataEntry then
            return
        end

        self._backdropHeat.BackgroundColor3 = windowRebuildWeatherRainDataEntry.Glow or Color3.fromRGB(255, 60, 15)
        local windowRebuildWeatherWeatherSize = self:_weatherSize()

        local windowRebuildWeatherCount = windowRebuildWeatherRainDataEntry.Count
            * self._weatherDensity
            * (self.WeatherMode == "UI" and 0.45 or 1)
        for windowRebuildWeatherIndex = 1, math.floor(windowRebuildWeatherCount + 0.5) do
            local windowRebuildWeatherParent, windowRebuildWeatherStateValue
            if windowRebuildWeatherRainDataEntry.Text then
                windowRebuildWeatherStateValue = "TextTransparency"
                windowRebuildWeatherParent = createInstance("TextLabel", {
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    BackgroundTransparency = 1,
                    Text = "",
                    TextColor3 = Color3.fromRGB(90, 255, 140),
                    TextTransparency = 1,
                    FontFace = Font.fromEnum(Enum.Font.Code),
                    TextXAlignment = Enum.TextXAlignment.Center,
                    TextYAlignment = Enum.TextYAlignment.Top,
                    LineHeight = 1,
                    ZIndex = 2,
                    Parent = self._weatherField,
                })

                createInstance("UIGradient", {
                    Rotation = 90,
                    Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
                        ColorSequenceKeypoint.new(0.88, Color3.new(1, 1, 1)),
                        ColorSequenceKeypoint.new(1, Color3.fromRGB(235, 255, 240)),
                    }),
                    Transparency = NumberSequence.new({
                        NumberSequenceKeypoint.new(0, 1),
                        NumberSequenceKeypoint.new(0.6, 0.45),
                        NumberSequenceKeypoint.new(1, 0),
                    }),
                    Parent = windowRebuildWeatherParent,
                })
            elseif windowRebuildWeatherRainDataEntry.Petal then
                windowRebuildWeatherStateValue = "BackgroundTransparency"
                windowRebuildWeatherParent = createInstance("Frame", {
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    BackgroundColor3 = Color3.fromRGB(255, 190, 210),
                    BackgroundTransparency = 1,
                    BorderSizePixel = 0,
                    ZIndex = 2,
                    Parent = self._weatherField,
                })
                addCorner(windowRebuildWeatherParent, UDim.new(1, 0))
                createInstance("UIGradient", {
                    Rotation = 35,
                    Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(235, 200, 215)),
                    Parent = windowRebuildWeatherParent,
                })
            else
                windowRebuildWeatherStateValue = "ImageTransparency"
                windowRebuildWeatherParent = createInstance("ImageLabel", {
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    BackgroundTransparency = 1,
                    Image = windowRebuildWeatherRainDataEntry.Image,
                    ImageTransparency = 1,
                    ScaleType = windowRebuildWeatherRainDataEntry.Stretch and Enum.ScaleType.Stretch
                        or Enum.ScaleType.Fit,
                    ZIndex = 2,
                    Parent = self._weatherField,
                })
            end
            local windowRebuildWeatherLabelData =
                { Label = windowRebuildWeatherParent, Property = windowRebuildWeatherStateValue }
            resetParticle(
                self.Weather,
                windowRebuildWeatherLabelData,
                windowRebuildWeatherWeatherSize.X,
                windowRebuildWeatherWeatherSize.Y,
                true
            )
            table.insert(self._weatherParticles, windowRebuildWeatherLabelData)
        end
    end

    function WindowMethods:_stepBackdrop(windowStepBackdropValue)
        local windowStepBackdropBackdropShown = self._backdropShown and 1 or 0
        local windowStepBackdropBackdropFade = self._backdropFade
        if
            windowStepBackdropBackdropFade == windowStepBackdropBackdropShown
            and windowStepBackdropBackdropShown == 0
        then
            return
        end
        if windowStepBackdropBackdropFade < windowStepBackdropBackdropShown then
            windowStepBackdropBackdropFade = math.min(
                windowStepBackdropBackdropFade + windowStepBackdropValue / 0.45,
                windowStepBackdropBackdropShown
            )
        elseif windowStepBackdropBackdropFade > windowStepBackdropBackdropShown then
            windowStepBackdropBackdropFade = math.max(
                windowStepBackdropBackdropFade - windowStepBackdropValue / 0.25,
                windowStepBackdropBackdropShown
            )
        end
        self._backdropFade = windowStepBackdropBackdropFade
        if windowStepBackdropBackdropFade <= 0 then
            self._backdrop.Visible = false
            self._weatherField.Visible = false
            return
        end
        local windowStepBackdropOffset = 1 - (1 - windowStepBackdropBackdropFade) ^ 3
        local windowStepBackdropWeather = self.Weather

        local windowStepBackdropDimLevel = self._dimLevel
        if self._backdropDim then
            windowStepBackdropDimLevel = math.min(windowStepBackdropDimLevel + windowStepBackdropValue / 0.3, 1)
        else
            windowStepBackdropDimLevel = math.max(windowStepBackdropDimLevel - windowStepBackdropValue / 0.3, 0)
        end
        self._dimLevel = windowStepBackdropDimLevel
        self._backdropTintFrame.BackgroundTransparency = 1
            - self._backdropTint * windowStepBackdropOffset * windowStepBackdropDimLevel
        local windowStepBackdropRainDataEntry = rainData[windowStepBackdropWeather]
        self._backdropHeat.BackgroundTransparency = windowStepBackdropWeather == "Ember"
                and 1 - (0.22 + math.sin(os.clock() * 2.1) * 0.05) * windowStepBackdropOffset
            or windowStepBackdropRainDataEntry and windowStepBackdropRainDataEntry.GlowAmount and 1 - (windowStepBackdropRainDataEntry.GlowAmount + math.sin(
                os.clock() * 0.8
            ) * windowStepBackdropRainDataEntry.GlowAmount * 0.25) * windowStepBackdropOffset
            or 1

        local windowStepBackdropWeatherKick = self._weatherKick
        self._weatherKick = math.max(windowStepBackdropWeatherKick - windowStepBackdropValue * 1.3, 0)
        local windowStepBackdropWeatherSpeed = self._weatherSpeed
            * (1 + windowStepBackdropWeatherKick * windowStepBackdropWeatherKick * 2.5)
        local windowStepBackdropWeatherSize = self:_weatherSize()
        local windowStepBackdropX, windowStepBackdropY =
            windowStepBackdropWeatherSize.X, windowStepBackdropWeatherSize.Y
        for windowStepBackdropKey, windowStepBackdropPosition in ipairs(self._weatherParticles) do
            windowStepBackdropPosition.Time += windowStepBackdropValue
            windowStepBackdropPosition.X += windowStepBackdropPosition.VX * windowStepBackdropValue * windowStepBackdropWeatherSpeed
            windowStepBackdropPosition.Y += windowStepBackdropPosition.VY * windowStepBackdropValue * windowStepBackdropWeatherSpeed
            windowStepBackdropPosition.Rotation += windowStepBackdropPosition.Spin * windowStepBackdropValue * windowStepBackdropWeatherSpeed
            local windowStepBackdropMaximum =
                math.max(windowStepBackdropPosition.Size.X, windowStepBackdropPosition.Size.Y)
            if windowStepBackdropPosition.Life then
                windowStepBackdropPosition.Age += windowStepBackdropValue
            end
            if
                (windowStepBackdropPosition.Life and windowStepBackdropPosition.Age > windowStepBackdropPosition.Life)
                or (
                    not windowStepBackdropPosition.Life
                    and (
                        (
                            windowStepBackdropPosition.VY > 0
                            and windowStepBackdropPosition.Y > windowStepBackdropY + windowStepBackdropMaximum
                        )
                        or (
                            windowStepBackdropPosition.VY < 0
                            and windowStepBackdropPosition.Y < -windowStepBackdropMaximum
                        )
                    )
                )
            then
                resetParticle(
                    windowStepBackdropWeather,
                    windowStepBackdropPosition,
                    windowStepBackdropX,
                    windowStepBackdropY,
                    false
                )
            elseif windowStepBackdropPosition.X > windowStepBackdropX + windowStepBackdropMaximum * 4 then
                windowStepBackdropPosition.X -= windowStepBackdropX + windowStepBackdropMaximum * 6
            elseif windowStepBackdropPosition.X < -windowStepBackdropMaximum * 4 then
                windowStepBackdropPosition.X += windowStepBackdropX + windowStepBackdropMaximum * 6
            end
            local windowStepBackdropX2 = windowStepBackdropPosition.X
            local windowStepBackdropOffset2 = 1 - windowStepBackdropPosition.Alpha
            if windowStepBackdropPosition.Sway ~= 0 then
                windowStepBackdropX2 += math.sin(
                    windowStepBackdropPosition.Time * windowStepBackdropPosition.Frequency
                        + windowStepBackdropPosition.Phase
                ) * windowStepBackdropPosition.Sway
            end
            local windowStepBackdropY2 = windowStepBackdropPosition.Y
            local windowStepBackdropLabel = windowStepBackdropPosition.Label
            if windowStepBackdropWeather == "Ember" then
                windowStepBackdropOffset2 *= math.clamp(
                    windowStepBackdropPosition.Y / (windowStepBackdropY * 0.85),
                    0,
                    1
                ) ^ 0.6
                windowStepBackdropOffset2 *= 0.75 + math.sin(
                    windowStepBackdropPosition.Time * 9 + windowStepBackdropPosition.Phase
                ) * 0.25
            elseif windowStepBackdropWeather == "Sakura" then
                local windowStepBackdropAbs = math.abs(
                    math.cos(
                        windowStepBackdropPosition.Time * windowStepBackdropPosition.Flutter
                            + windowStepBackdropPosition.Phase
                    )
                )
                windowStepBackdropLabel.Size = UDim2.fromOffset(
                    windowStepBackdropPosition.Size.X * (0.3 + windowStepBackdropAbs * 0.7),
                    windowStepBackdropPosition.Size.Y
                )
            elseif windowStepBackdropWeather == "Fireflies" then
                windowStepBackdropY2 += math.cos(
                    windowStepBackdropPosition.Time * windowStepBackdropPosition.Frequency * 1.3
                        + windowStepBackdropPosition.Phase
                ) * windowStepBackdropPosition.SwayY
                local windowStepBackdropAge, windowStepBackdropLife =
                    windowStepBackdropPosition.Age, windowStepBackdropPosition.Life
                windowStepBackdropOffset2 *= math.clamp(
                    math.min(windowStepBackdropAge / 1.2, (windowStepBackdropLife - windowStepBackdropAge) / 1.2),
                    0,
                    1
                )
                windowStepBackdropOffset2 *= 0.5 + math.sin(
                    windowStepBackdropPosition.Time * windowStepBackdropPosition.Pulse
                        + windowStepBackdropPosition.Phase
                ) * 0.5
            elseif windowStepBackdropWeather == "Matrix" then
                windowStepBackdropPosition.Shuffle -= windowStepBackdropValue * windowStepBackdropWeatherSpeed
                if windowStepBackdropPosition.Shuffle <= 0 then
                    windowStepBackdropPosition.Shuffle = randomRange(0.05, 0.2)
                    local windowStepBackdropList = rainData.Matrix.List
                    local windowStepBackdropChars = windowStepBackdropPosition.Chars
                    windowStepBackdropChars[math.random(#windowStepBackdropChars)] =
                        windowStepBackdropList[math.random(#windowStepBackdropList)]
                    windowStepBackdropChars[#windowStepBackdropChars] =
                        windowStepBackdropList[math.random(#windowStepBackdropList)]
                    windowStepBackdropLabel.Text = table.concat(windowStepBackdropChars, "\n")
                end
            end
            windowStepBackdropLabel.Position = UDim2.fromOffset(windowStepBackdropX2, windowStepBackdropY2)
            windowStepBackdropLabel.Rotation = windowStepBackdropPosition.Rotation
            windowStepBackdropLabel[windowStepBackdropPosition.Property or "ImageTransparency"] = 1
                - windowStepBackdropOffset2 * windowStepBackdropOffset
        end
    end

    function WindowMethods:_refreshBackdrop(windowRefreshBackdropValue)
        if not self._backdrop then
            return
        end
        local windowRefreshBackdropOpen = self._backdropEnabled
            and self._introDone
            and self.Open
            and not self.Minimized
            and not self._destroyed
        if windowRefreshBackdropOpen and not self._backdropShown then
            self._backdrop.Visible = true
            self._weatherField.Visible = true
            if self._backdropFade <= 0 then
                local windowRefreshBackdropWeatherSize = self:_weatherSize()
                for windowRefreshBackdropKey, windowRefreshBackdropItem in ipairs(self._weatherParticles) do
                    resetParticle(
                        self.Weather,
                        windowRefreshBackdropItem,
                        windowRefreshBackdropWeatherSize.X,
                        windowRefreshBackdropWeatherSize.Y,
                        true
                    )
                end
            end
            if windowRefreshBackdropValue then
                self._weatherKick = 1
            end
        end
        self._backdropShown = windowRefreshBackdropOpen == true
    end

    function WindowMethods:SetBackdrop(windowSetBackdropValue)
        if not self._backdrop then
            return
        end
        self._backdropEnabled = windowSetBackdropValue ~= false
        self:_refreshBackdrop(true)
    end

    function WindowMethods:SetBackdropTint(windowSetBackdropTintValue)
        if not self._backdrop then
            return
        end
        self._backdropTint = math.clamp(tonumber(windowSetBackdropTintValue) or 0.45, 0, 1)
    end

    function WindowMethods:SetDim(windowSetDimValue)
        if not self._backdrop then
            return
        end
        self._backdropDim = windowSetDimValue ~= false
    end

    function WindowMethods:SetWeatherMode(windowSetWeatherModeWeatherMode)
        if not self._backdrop then
            return
        end
        windowSetWeatherModeWeatherMode = normalizeParticleLayer(windowSetWeatherModeWeatherMode)
        local windowSetWeatherModeWeatherField = self._weatherField
        if windowSetWeatherModeWeatherMode == "UI" then
            windowSetWeatherModeWeatherField.ZIndex = 0
            windowSetWeatherModeWeatherField.Parent = self.Body
        else
            windowSetWeatherModeWeatherField.ZIndex = 2
            windowSetWeatherModeWeatherField.Parent = self._backdrop
        end
        if windowSetWeatherModeWeatherMode == self.WeatherMode then
            return
        end
        self.WeatherMode = windowSetWeatherModeWeatherMode
        self:_rebuildWeather()
        if self._backdropShown then
            self._weatherKick = 1
        end
    end

    function WindowMethods:SetWeather(windowSetWeatherValue)
        if not self._backdrop then
            return
        end
        local windowSetWeatherWeather = normalizeParticleEffect(windowSetWeatherValue)
        if windowSetWeatherWeather == self.Weather then
            return
        end
        self.Weather = windowSetWeatherWeather
        self:_rebuildWeather()
        if self._backdropShown then
            self._weatherKick = 1
        end
    end

    function WindowMethods:SetWeatherDensity(windowSetWeatherDensityValue)
        if not self._backdrop then
            return
        end
        self._weatherDensity = math.clamp(tonumber(windowSetWeatherDensityValue) or 1, 0, 3)
        self:_rebuildWeather()
    end

    function WindowMethods:SetWeatherSpeed(windowSetWeatherSpeedValue)
        if not self._backdrop then
            return
        end
        self._weatherSpeed = math.clamp(tonumber(windowSetWeatherSpeedValue) or 1, 0.1, 3)
    end

