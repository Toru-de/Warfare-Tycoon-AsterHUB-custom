    if type(config)~="table" or config.Type~="Melee" then extension.reason="Equip a melee weapon"; return nil end
    local humanoid=character:FindFirstChildOfClass("Humanoid")
    local camera=workspace.CurrentCamera
    if not humanoid or humanoid.Health<=0 or not camera then extension.reason="Waiting for a living character"; return nil end
    local actualOrigin=camera.CFrame.Position
    local record=chooseExtendedTarget(actualOrigin)
    extension.target=record
    if not record then extension.reason="No eligible character in range"; return nil end
    local part=aimPart(record)
    local offset=part.Position-actualOrigin
    if offset.Magnitude<0.01 then return nil end
    local direction=offset.Unit
    -- Keep the stock four-stud melee packet. Only its contact origin is moved;
    -- the real player and character remain in place. Server acceptance is separate.
    local origin=part.Position-direction*2
    return {origin=origin,direction=direction,part=part,record=record,tool=tool,melee=true,
        generation=extension.generation,distance=offset.Magnitude,
        interval=math.max(0.1,60/math.max(tonumber(config.ShootRate) or 60,1)),
        serializer=up[6],events=up[7],data={shellType="Melee",shellName="DefaultMelee",
            shellSpeed=100,shellMaxDist=4,weaponName=tool.Name,filterDescendants={character,up[3]},origin=origin}}
end
local function dispatchExtendedMelee(original)
    local shot=planExtendedMelee(original)
    if not shot or not extendedValid(shot) then return false end
    extension.nextAttack=os.clock()+shot.interval
    extension.busy=true
    extension.reason="Melee contact requests active"
    local thread
    -- Defer lets us register the coroutine before it can complete or yield in InvokeServer.
    thread=task.defer(function()
        local ok,problem=pcall(function()
            if not extendedValid(shot) then return end
            shot.events:FindFirstChild("ServerBullet"):FireServer(shot.origin,shot.direction,shot.serializer.ToArray(shot.data))
            if extendedValid(shot) then resolveExtended(shot) end
        end)
        if not ok then extension.errors+=1; extension.lastError=tostring(problem) end
        extension.tasks[thread]=nil
        if shot.generation==extension.generation then extension.busy=false end
    end)
    extension.tasks[thread]=true
    return true
end
local function restoreMeleeHook()
    if extension.hook then pcall(restorefunction,extension.hook) end
    extension.hook,extension.original=nil,nil
end
local function installMeleeHook()
    if not extensionActive() then return end
    local candidate: any=activeMelee()
    if not candidate or candidate==extension.hook then return end
    local up: any=debug.getupvalues(candidate)
    if up[2]~=localPlayer.Character or up[5]~=localPlayer or type(up[6])~="table" then return end
    restoreMeleeHook()
    local original
    original=hookfunction(candidate,function(...)
        if not extensionActive() then return original(...) end
        local ok,handled=pcall(dispatchExtendedMelee,original)
        if not ok then extension.errors+=1; extension.lastError=tostring(handled); return original(...) end
        if not handled and not extension.busy and os.clock()>=extension.nextAttack then return original(...) end
        return nil
    end)
    extension.hook,extension.original=candidate,original
end
local function stopExtension()
    settings.ExtendedSilent=false
    extension.generation+=1
    if extension.worker then pcall(task.cancel,extension.worker); extension.worker=nil end
    for thread in extension.tasks do pcall(task.cancel,thread) end
    table.clear(extension.tasks)
    restoreMeleeHook()
    extension.busy=false
    extension.target=nil
    extension.reason="Disabled"
end
local function setExtension(enabled)
    stopExtension()
    if not enabled or not running then return end
    settings.ExtendedSilent=true
    extension.reason="Equip a melee weapon, or fire an ordinary gun"
    extension.worker=task.defer(function()
        while extensionActive() do
            local ok,problem=pcall(function()
                installMeleeHook()
                if settings.ExtendedMelee and extension.original then dispatchExtendedMelee(extension.original) end
            end)
            if not ok then extension.errors+=1; extension.lastError=tostring(problem) end
            task.wait(0.1)
        end
    end)
end
table.insert(disposers,stopExtension)
local function extensionStatus()
    local pending=0
    for _ in extension.tasks do pending+=1 end
    return {enabled=extensionActive(),hooked=extension.hook~=nil,worker=extension.worker~=nil,
        pending=pending,busy=extension.busy==true,requests=extension.requests,meleeRequests=extension.meleeRequests,
        bulletRequests=extension.bulletRequests,selections=extension.selections or 0,healthDrops=extension.healthDrops,
        target=extension.target and extension.target.model.Name,reason=extension.reason,errors=extension.errors,
        lastError=extension.lastError,lastRequest=extension.lastRequest,serverAcceptance="Requires gameplay confirmation"}
end
local function planShot(originalCreate, ads)
    local up: any = debug.getupvalues(originalCreate)
    local config, tool, character = up[3], up[4], up[6]
    if type(config)=="table" and tool and tool.Name=="RPG-7" then return planRPGShot(up,ads) end
    if type(config) ~= "table" or not tool or config.Type ~= "Gun"
        or (config.CustomShellType and config.CustomShellType ~= "Bullet") then return nil end
    stats.seen += 1
    if (not settings.InstantBullets and not aimActive() and not extensionActive()) or character ~= localPlayer.Character
        or character:GetAttribute("Powerup_RocketBullets") then return nil end
    local viewmodel, camera = up[2], workspace.CurrentCamera
    if not camera then return nil end
    local muzzle = viewmodel and viewmodel:FindFirstChild("Handle")
    muzzle = muzzle and muzzle:FindFirstChild("Muzzle")
    if not ads and not muzzle then return nil end
    local origin = ads and camera.CFrame.Position or muzzle.WorldCFrame.Position
    local extended=chooseExtendedTarget(origin,tonumber(config.ShellMaxDist) or 7000)
    local record = extended or (aimActive() and chooseTarget(origin, tonumber(config.ShellMaxDist)) or nil)
    local instant=settings.InstantBullets or extended~=nil
    if extended then extension.target=extended end
    selected = record
    if not record and not instant then return nil end
    local part = record and aimPart(record)
    local speed = tonumber(config.MuzzleVelocity) or 300
    local velocity = not instant and settings.Prediction and record and record.root.AssemblyLinearVelocity or Vector3.zero
    local direction, flight
    if instant then
        if part then
            local relative = part.Position-origin
            if relative.Magnitude < 0.001 then return nil end
            direction = relative.Unit
        else
            -- No Silent Aim target: preserve the game's manual aim/spread and
            -- still remove projectile travel for this ordinary bullet.
            local frame = ads and camera.CFrame or muzzle.WorldCFrame
            local reference = up[14] and up[14].CFrame or frame
            local alignment = (frame.LookVector-reference.LookVector).Magnitude < 0.2 and reference or frame
            local spread = (up[11] or 0)/10
            if up[12] and not up[12].SpreadModsAreOnlyVisual then spread += (up[13] or 0)*(config.WalkMult or 0)/10 end
            local reduction = math.min(1,1-(up[10] and up[10].Progress or 0)+(config.AimSpreadMod or 0))
            direction = CFrame.Angles(math.rad(math.random(-spread,spread)*reduction),
                math.rad(math.random(-spread,spread)*reduction),math.rad(math.random(-spread,spread)*reduction))*alignment.LookVector
            if tool.Name == ".44 Magnum" and up[15].isInProgress("ADS") then direction = camera.CFrame.LookVector end
        end
        flight = 0
    else
        direction, flight = intercept(origin, part.Position, velocity, speed, baseAcceleration, math.min(15, (config.ShellMaxDist or 7000) / speed))
    end
    if not direction then return nil end
    local position = part and part.Position or origin+direction*(config.ShellMaxDist or 7000)
    stats.lastShot = {weapon = tool.Name, target = record and record.model.Name or "Manual aim", speed = speed, flight = flight,
        distance = (position-origin).Magnitude, velocity = velocity, leadStuds = velocity.Magnitude*flight,
        aimPart = part and part.Name or "Crosshair", ads = ads, origin = origin, targetPosition = position, direction = direction,
        instant = instant,extended = extended~=nil}
    -- Exact metadata schema from this game's ACS CreateBullet and BulletSerializer.
    local shellType = config.CustomShellType or "Bullet"
    local localShell = ads and "Invisible" or config.CustomShellName
    local data = {
        weaponName = tool.Name,
        bulletID = localPlayer.Name .. localPlayer.UserId .. tick() .. math.random(111,999) .. math.random(111,999),
        maxPenetrationCount = config.maxPenetrationCount or 3,
        currentPenetrationCount = 0, penetrationMultiplier = config.penetrationMultiplier or 0.8,
        shellType = shellType, shellName = config.CustomShellName, localShellName = localShell,
        shellSpeed = speed, shellMaxDist = config.ShellMaxDist or 7000,
        filterDescendants = {character, up[7]}, origin = origin,
    }
    if up[8] and type(up[8].stat) == "function" and math.random() < up[8].stat("CritChance", 0) then data.crit = true end
    return {origin = origin, direction = direction, data = data, shoot = up[16], serializer = up[18], events = up[19], instant = instant,
        extended=extended~=nil,part=part,record=record,tool=tool,generation=extension.generation,distance=(position-origin).Magnitude}
end

-- The plane's GetAimPoint feeds the SAME vector to local ShootModule.fire and
-- ServerBullet. Detouring this one closure preserves ammo, timing and networking.
local function sameSquad(person)
    for _, key in {"SquadIndex", "MG_Team"} do
        local mine, theirs = localPlayer:GetAttribute(key), person:GetAttribute(key)
        if mine ~= nil and theirs ~= nil and mine == theirs then return true end
    end
    return false
end
local function localVehicle()
    local character = localPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local seat = humanoid and humanoid.SeatPart
    return seat and seat:FindFirstAncestorOfClass("Model")
end
local function migSeated()
    local model = localVehicle()
    local required = model and model:FindFirstChild("Required")
    return model ~= nil and model.Name=="Mig-23" and required ~= nil and required:FindFirstChild("PlaneSeat") ~= nil
end
local function rpgEquipped()
    local character = localPlayer.Character
    local tool = character and character:FindFirstChild("RPG-7")
    return tool ~= nil and tool:IsA("Tool")
end
local function vehicleInfo(seat)
    if not (seat:IsA("VehicleSeat") or seat:IsA("Seat")) or not seat:IsDescendantOf(workspace) then return nil end
    local model = seat:FindFirstAncestorOfClass("Model")
    local params = model and model:FindFirstChild("Params")
    local health: any = params and params:FindFirstChild("VehicleHealth")
    if not model or not health or not (health:IsA("NumberValue") or health:IsA("IntValue")) or health.Value<=0 then return nil end
    local root = model.PrimaryPart or seat
    return model,root,health
end
local function removeVehicle(model)
    local record = vehicles[model]
    if not record then return end
    vehicles[model] = nil
    for _, object in record.objects do
        pcall(function() object:Remove() end)
        if drawings[object] then drawings[object]=nil; drawingCount-=1 end
    end
    record.highlight:Destroy()
    if rpg.target==record then rpg.target=nil end
    if aviation.target==record then aviation.target=nil end
end
table.insert(disposers,function() for model in vehicles do removeVehicle(model) end end)
local function refreshVehicles()
    local seen = {}
    for _, seat in game:GetService("CollectionService"):GetTagged("HeatseekSeat") do
        local model,root,health = vehicleInfo(seat)
        if not model or seen[model] then continue end
        seen[model] = true
        local record = vehicles[model]
        if not record then
            record = {model=model,root=root,vehicleHealth=health,objects={},boundsTime=0}
            local function item(kind,properties)
                local object = draw(kind,properties)
                table.insert(record.objects,object)
                return object
            end
            record.border = item("Square",{Filled=false,Thickness=3.5,Color=Color3.new(0,0,0),Transparency=0.85})
            record.box = item("Square",{Filled=false,Thickness=1.5,Transparency=1})
            record.name = item("Text",{Size=14,Font=2,Center=true,Outline=true,OutlineColor=Color3.new(0,0,0)})
            record.info = item("Text",{Size=12,Font=2,Center=true,Outline=true,OutlineColor=Color3.new(0,0,0)})
            record.arrow = item("Triangle",{Filled=true,Thickness=1,Transparency=0.9})
            local highlight = Instance.new("Highlight")
            highlight.Name = "AsterWarfareVehicle"
            highlight.Adornee = model
            highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            highlight.FillTransparency,highlight.OutlineTransparency = 0.94,0.15
            highlight.Enabled,highlight.Parent = false,model
            record.highlight = highlight
            vehicles[model] = record
        end
        if record.root ~= root then record.boundsTime=0 end
        record.root,record.vehicleHealth,record.seat = root,health,seat
        record.player = seat.Occupant and Players:GetPlayerFromCharacter(seat.Occupant.Parent) or nil
    end
    for model,record in vehicles do
        if not seen[model] or not record.root.Parent or record.vehicleHealth.Value<=0 then removeVehicle(model) end
    end
end
local function vehicleCandidates(origin,maxDistance,fov,teamCheck)
    local camera = workspace.CurrentCamera
    if not camera then return {} end
    local center,own,result = camera.ViewportSize/2,localVehicle(),{}
    for model,record in vehicles do
        if not model.Parent or not record.root.Parent or record.vehicleHealth.Value<=0 or model==own then continue end
        if record.player==localPlayer or (record.player and teamCheck and sameSquad(record.player)) then continue end
        local point,onScreen = camera:WorldToViewportPoint(record.root.Position)
        local pixels = (Vector2.new(point.X,point.Y)-center).Magnitude
        if onScreen and point.Z>0 and pixels<=fov and (record.root.Position-origin).Magnitude<=maxDistance then
            table.insert(result,{record=record,part=record.root,pixels=pixels})
        end
    end
    return result
end
local function chooseRPGTarget(origin,maxDistance)
    local candidates = vehicleCandidates(origin,math.min(settings.RPGMaxDistance,maxDistance),settings.RPGFOV,settings.RPGTeamCheck)
    table.sort(candidates,function(a,b) return a.pixels<b.pixels end)
    for _, candidate in candidates do
        if not settings.RPGVisibleOnly or clearPath(origin,candidate.part.Position,candidate.record,localVehicle()) then
            return candidate.record,candidate.part
        end
    end
    return nil
end
planRPGShot = function(up,ads)
    rpg.seen += 1
    local config,tool,character = up[3],up[4],up[6]
    if not running or not settings.RPGAim or character~=localPlayer.Character then rpg.reason="disabled"; return nil end
    if config.Type~="Launcher" or config.CustomShellType~="Explosive" then rpg.reason="RPG configuration changed"; return nil end
    local camera = workspace.CurrentCamera
    local handle = up[2] and up[2]:FindFirstChild("Handle")
    local muzzle = handle and handle:FindFirstChild("Muzzle")
    if not camera or (not ads and not muzzle) then rpg.reason="waiting for weapon muzzle"; return nil end
    local origin = ads and camera.CFrame.Position or muzzle.WorldCFrame.Position
    local record,part = chooseRPGTarget(origin,config.ShellMaxDist or 7000)
    rpg.target = record
    if not record then rpg.reason="No vehicle inside RPG FOV"; return nil end
    local speed = config.MuzzleVelocity or 400
    local velocity = not settings.RPGInstant and settings.RPGPrediction and record.root.AssemblyLinearVelocity or Vector3.zero
    local direction,flight
    if settings.RPGInstant then
        local relative=part.Position-origin
        if relative.Magnitude<0.001 then return nil end
        direction,flight=relative.Unit,0
    else
        direction,flight=intercept(origin,part.Position,velocity,speed,baseAcceleration,math.min(15,(config.ShellMaxDist or 7000)/speed))
    end
    if not direction then rpg.reason="No ballistic solution"; return nil end
    local data = {
        weaponName=tool.Name,bulletID=localPlayer.Name..localPlayer.UserId..tick()..math.random(111,999)..math.random(111,999),
        maxPenetrationCount=config.maxPenetrationCount or 3,currentPenetrationCount=0,
        penetrationMultiplier=config.penetrationMultiplier or 0.8,shellType=config.CustomShellType,
        shellName=config.CustomShellName,localShellName=config.CustomShellName,
        shellSpeed=speed,shellMaxDist=config.ShellMaxDist or 7000,filterDescendants={character,up[7]},origin=origin,
    }
    rpg.reason = "Vehicle aim ready"
    rpg.lastShot = {target=record.model.Name,kind="Vehicle",speed=speed,flight=flight,velocity=velocity,
        origin=origin,position=part.Position,direction=direction,instant=settings.RPGInstant,shellType=data.shellType}
    return {origin=origin,direction=direction,data=data,shoot=up[16],serializer=up[18],events=up[19],instant=settings.RPGInstant,explosive=true,rpg=true}
end
local function renderVehicles(camera,overlays)
    local active = settings.ESP and settings.VehicleESPInMig and migSeated()
    stats.vehicleESPActive,stats.vehicleVisible = active,0
    local own = localVehicle()
    local view,center = camera.ViewportSize,camera.ViewportSize/2
    for model,record in vehicles do
        for _, object in record.objects do object.Visible=false end
        record.highlight.Enabled=false
        if not active or not overlays or model==own or not model.Parent or not record.root.Parent or record.vehicleHealth.Value<=0 then continue end
        local distance = (record.root.Position-camera.CFrame.Position).Magnitude
        if distance>settings.VehicleMaxDistance then continue end
        local color = (record==rpg.target or record==aviation.target) and settings.TargetColor or settings.VehicleColor
        local point,onScreen = camera:WorldToViewportPoint(record.root.Position)
        if onScreen and point.Z>0 then
            stats.vehicleVisible += 1
            record.highlight.Enabled = settings.VehicleChams
            record.highlight.FillColor,record.highlight.OutlineColor = color,color
            if os.clock()-record.boundsTime>2 then
                local ok,bounds,size = pcall(model.GetBoundingBox,model)
                if ok then record.boundsOffset=record.root.CFrame:ToObjectSpace(bounds); record.boundsSize=size end
                record.boundsTime=os.clock()
            end
            local x,y,width,height = point.X-20,point.Y-15,40,30
            if record.boundsOffset and record.boundsSize then
                local bounds = record.root.CFrame*record.boundsOffset
                local half = record.boundsSize/2
                local minX,minY,maxX,maxY = math.huge,math.huge,-math.huge,-math.huge
                local valid=true
                for _, sx in {-1,1} do for _, sy in {-1,1} do for _, sz in {-1,1} do
                    local projected = camera:WorldToViewportPoint(bounds:PointToWorldSpace(Vector3.new(half.X*sx,half.Y*sy,half.Z*sz)))
                    if projected.Z<=0 then valid=false end
                    minX,minY,maxX,maxY = math.min(minX,projected.X),math.min(minY,projected.Y),math.max(maxX,projected.X),math.max(maxY,projected.Y)
                end end end
                if valid and maxX-minX<view.X*3 and maxY-minY<view.Y*3 then x,y,width,height=minX,minY,maxX-minX,maxY-minY end
            end
            if settings.VehicleBoxes then
                record.border.Position,record.box.Position = Vector2.new(x,y),Vector2.new(x,y)
                record.border.Size,record.box.Size = Vector2.new(width,height),Vector2.new(width,height)
                record.box.Color = color
                record.border.Visible,record.box.Visible=true,true
            end
            if settings.VehicleNames then
                record.name.Text,record.name.Color=model.Name,color
                record.name.Position,record.name.Visible=Vector2.new(x+width/2,math.max(2,y-18)),true
            end
            local details={}
            if settings.VehicleHealth then table.insert(details,string.format("%d HP",math.floor(record.vehicleHealth.Value+0.5))) end
            if settings.VehicleDistance then table.insert(details,string.format("%d studs",math.floor(distance))) end
            if #details>0 then
                record.info.Text,record.info.Color=table.concat(details,"  |  "),Color3.fromRGB(225,232,241)
                record.info.Position,record.info.Visible=Vector2.new(x+width/2,y+height+3),true
            end
        elseif settings.VehicleArrows then
            local relative = camera.CFrame:PointToObjectSpace(record.root.Position)
            local direction = Vector2.new(relative.X,-relative.Y)
            if direction.Magnitude<0.001 then direction=Vector2.new(0,1) end
            direction=direction.Unit
            local edge = center+direction*math.min((view.X/2-30)/math.max(math.abs(direction.X),0.001),(view.Y/2-40)/math.max(math.abs(direction.Y),0.001))
            local side=Vector2.new(-direction.Y,direction.X)
            record.arrow.PointA,record.arrow.PointB,record.arrow.PointC=edge+direction*10,edge-direction*7+side*6,edge-direction*7-side*6
            record.arrow.Color,record.arrow.Visible=color,true
        end
    end
end
local function vehicleStatus()
    local count=0
    for _ in vehicles do count+=1 end
    return {tracked=count,migSeated=migSeated(),espActive=stats.vehicleESPActive==true,visible=stats.vehicleVisible or 0,
        rpgEquipped=rpgEquipped(),rpgEnabled=settings.RPGAim,rpgSeen=rpg.seen,rpgAssisted=rpg.assisted,
        rpgTarget=rpg.target and rpg.target.model.Name,rpgReason=rpg.reason,instantBullets=settings.InstantBullets,rpgInstant=settings.RPGInstant}
end
local function rocketWeapon()
    local plane, module = aviation.plane, aviation.module
    if not plane or not module or module.Plane ~= plane or plane.Name ~= "Mig-23" then return nil end
    -- The HUD can say NONE while S-8 is selected. Read the live firing callback.
    local loop = aviation.fireLoop
    if not loop then return nil end
    local up: any = debug.getupvalues(loop)
    if up[4] ~= plane or up[6] ~= localPlayer then return nil end
    local config: any = up[2]
    if type(config) == "table" and config.Name == "S-8 Rockets" and not config.SpecialType then return config end
    return nil
end
local function findPlaneFireLoop(plane)
    for _, connection in getconnections(RunService.Heartbeat) do
        local callback: any = connection.Function
        if type(callback) ~= "function" or getfenv(callback).script ~= aviation.weaponScript then continue end
        local up: any = debug.getupvalues(callback)
        if up[4] == plane and up[6] == localPlayer and up[7] == aviation.hook then return callback end
    end
    return nil
end
local function rocketOrigin(plane, config)
    local hardpoints = plane:FindFirstChild("Hardpoints")
    local point = hardpoints and config.HardpointData and hardpoints:FindFirstChild(config.HardpointData.Name)
    -- This game's Mig-23 uses a BasePart named Hardpoints.Heatseekers.
    if point and point:IsA("BasePart") then return point.Position end
    return nil
end
local function chooseRocketTarget(origin, maxDistance)
    local camera = workspace.CurrentCamera
    if not camera then return nil end
    local center, candidates = camera.ViewportSize / 2, {}
    for _, record in records do
        local eligible = record.model.Parent and record.root.Parent and record.humanoid.Health > 0
            and record.model ~= localPlayer.Character and not record.model:FindFirstChildOfClass("ForceField")
        if record.player then
            eligible = eligible and settings.RocketPlayers and record.player ~= localPlayer
                and (not settings.RocketTeamCheck or not sameSquad(record.player))
        else eligible = eligible and settings.RocketNPCs end
        if eligible then
            local part = record.model:FindFirstChild("UpperTorso") or record.model:FindFirstChild("Torso") or record.root
            local point, onScreen = camera:WorldToViewportPoint(part.Position)
            local pixels = (Vector2.new(point.X, point.Y) - center).Magnitude
            local distance = (part.Position - origin).Magnitude
            if onScreen and point.Z > 0 and pixels <= settings.RocketFOV
                and distance <= math.min(settings.RocketMaxDistance, maxDistance) then
                table.insert(candidates, {record = record, part = part, pixels = pixels})
            end
        end
    end
    if settings.RocketVehicles then
        for _, candidate in vehicleCandidates(origin,math.min(settings.RocketMaxDistance,maxDistance),settings.RocketFOV,settings.RocketTeamCheck) do table.insert(candidates,candidate) end
    end
    table.sort(candidates, function(a,b) return a.pixels < b.pixels end)
    for _, candidate in candidates do
        if not settings.RocketVisibleOnly or clearPath(origin, candidate.part.Position, candidate.record, aviation.plane) then
            return candidate.record, candidate.part
        end
    end
    return nil
end
local function rocketPoint(plane)
    if not settings.RocketSilent or plane ~= aviation.plane then aviation.reason = "disabled / not piloting"; return nil end
    local config = rocketWeapon()
    if not config then aviation.reason = "select S-8 Rockets"; return nil end
    local origin = rocketOrigin(plane, config)
    if not origin then aviation.reason = "missing rocket muzzle"; return nil end
    local record, part = chooseRocketTarget(origin, config.ShellMaxDist or 7000)
    aviation.target = record
    if not record then aviation.reason = "no eligible target in rocket FOV"; return nil end
    local speed = config.MuzzleVelocity or 600
    local acceleration = config.ShellGravity or baseAcceleration
    local velocity = settings.RocketPrediction and record.root.AssemblyLinearVelocity or Vector3.zero
    local direction, flight = intercept(origin, part.Position, velocity, speed, acceleration,
        math.min(15, (config.ShellMaxDist or 7000) / speed))
    if not direction then aviation.reason = "no ballistic solution"; return nil end
    aviation.reason = "aim ready"
    aviation.lastShot = {target=record.model.Name,kind=record.vehicleHealth and "Vehicle" or "Character",
        weapon=config.Name,origin=origin,position=part.Position,velocity=velocity,speed=speed,
        flight=flight,direction=direction,distance=(part.Position-origin).Magnitude}
    return origin + direction * speed * flight
end
local function flareDecision(enabled, pilot, active, elapsed, cooldown, threat, onLock)
    if not enabled then return false, "disabled" end
    if not pilot then return false, "not piloting" end
    if active then return false, "already active" end
    if elapsed < cooldown then return false, "cooldown" end
    if threat ~= "IncomingProjectile" and not (onLock and threat == "Locking") then return false, "no incoming missile" end
    return true, "ready"
end
local function deployFlares()
    local plane, module = aviation.plane, aviation.module
    local elapsed = os.time() - (module and module.flaresLastDeployed or 0)
    local threat = os.clock() <= aviation.threatUntil and aviation.threat or nil
    local ready = flareDecision(settings.AutoFlares, plane ~= nil and module ~= nil and module.Plane == plane,
        plane and plane:GetAttribute("Flares"), elapsed, aviation.cooldown or 26, threat, settings.FlaresOnLock)
    if not ready then return false end
    local remote = aviation.flareRemote
    if not remote then return false end
    local stamp = os.time()
    module.flaresLastDeployed = stamp
    if aviation.ui then aviation.ui.flaresLastDeployed = stamp end
    aviation.pendingConfirm = os.clock()
    remote:FireServer()
    aviation.flares += 1
    aviation.threatUntil = 0
    return true
end
local function disconnectAircraft()
    for _, connection in aviation.connections do connection:Disconnect() end
    table.clear(aviation.connections)
    aviation.plane, aviation.flareRemote, aviation.target = nil, nil, nil
    aviation.fireLoop, aviation.fireSession = nil, nil
    aviation.threat, aviation.pendingConfirm = nil, nil
    aviation.threatUntil = 0
end
local function removeAircraftHook()
    disconnectAircraft()
    if aviation.hook then pcall(restorefunction, aviation.hook) end
    aviation.hook, aviation.module, aviation.ui, aviation.script, aviation.weaponScript = nil, nil, nil, nil, nil
end
table.insert(disposers, removeAircraftHook)
local function refreshAircraft()
    local character = localPlayer.Character
    local planeControl = character and character:FindFirstChild("PlaneControl")
    if planeControl ~= aviation.script then
        removeAircraftHook()
        local weaponModule = planeControl and planeControl:FindFirstChild("WeaponModule")
        local uiModule = planeControl and planeControl:FindFirstChild("UIModule")
        if not weaponModule or not uiModule then return end
        local module: any = require(weaponModule)
        local up: any = debug.getupvalues(module.SetPlane)
        local aimFunction = up[16]
        if type(aimFunction) ~= "function" or debug.info(aimFunction, "n") ~= "GetAimPoint" then
            error("Aircraft aim-point layout changed")
        end
        aviation.module, aviation.ui, aviation.weaponScript = module, require(uiModule), weaponModule
        aviation.cooldown = (type(up[21]) == "table" and up[21].Cooldown or 25) + 1
        local originalAim
        originalAim = hookfunction(aimFunction, function(plane, distance)
            aviation.seen += 1
            if running then
                local ok, point = pcall(rocketPoint, plane)
                if ok and point then aviation.assisted += 1; return point end
                if not ok then aviation.errors += 1; warn("[Aster Warfare] rockets", point) end
            end
            return originalAim(plane, distance)
        end)
        aviation.hook, aviation.script = aimFunction, planeControl
    end
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local seat = humanoid and humanoid.SeatPart
    local plane = seat and seat:FindFirstAncestorOfClass("Model")
    local required = plane and plane:FindFirstChild("Required")
    if not required or required:FindFirstChild("PlaneSeat") ~= seat or plane.Name ~= "Mig-23"
        or not aviation.module or aviation.module.Plane ~= plane then plane = nil end
    if plane == aviation.plane then
        if plane then
            local session = debug.getupvalue(aviation.module.SetPlane,11)
            if not aviation.fireLoop or aviation.fireSession ~= session then
                aviation.fireLoop, aviation.fireSession = findPlaneFireLoop(plane), session
            end
        end
        return
    end
    disconnectAircraft()
    aviation.plane = plane
    if not plane then return end
    aviation.fireLoop = findPlaneFireLoop(plane)
    aviation.fireSession = debug.getupvalue(aviation.module.SetPlane,11)
    local networking = plane:FindFirstChild("Networking")
    local rocketRemote = networking and networking:FindFirstChild("RocketEvent")
    aviation.flareRemote = networking and networking:FindFirstChild("FlareEvent")
    if rocketRemote then
        table.insert(aviation.connections, rocketRemote.OnClientEvent:Connect(function(kind)
            aviation.warnings += 1
            if kind ~= "IncomingProjectile" and kind ~= "Locking" then return end
            if kind == "IncomingProjectile" then aviation.incoming += 1 else aviation.locking += 1 end
            if kind == "Locking" and aviation.threat == "IncomingProjectile" and os.clock() <= aviation.threatUntil then return end
            aviation.threat, aviation.threatUntil = kind, os.clock() + 3
            local ok, problem = pcall(deployFlares)
            if not ok then aviation.errors += 1; warn("[Aster Warfare] flares", problem) end
        end))
    end
    table.insert(aviation.connections, plane:GetAttributeChangedSignal("Flares"):Connect(function()
        if plane:GetAttribute("Flares") and aviation.pendingConfirm then
            if os.clock() - aviation.pendingConfirm <= 3 then aviation.confirmed += 1 end
            aviation.pendingConfirm = nil
        end
    end))
end
local function aircraftStatus()
    return {plane = aviation.plane and aviation.plane.Name, attached = aviation.hook ~= nil,
        weapon = rocketWeapon() and "S-8 Rockets", target = aviation.target and aviation.target.model.Name,
        calls = aviation.seen, assisted = aviation.assisted, warnings = aviation.warnings,
        incoming = aviation.incoming, locking = aviation.locking, flaresSent = aviation.flares,
        flaresConfirmed = aviation.confirmed, errors = aviation.errors,
        cooldownRemaining = aviation.module and math.max(0, (aviation.module.flaresLastDeployed or 0) + (aviation.cooldown or 26) - os.time()) or 0,
        rocketEnabled = settings.RocketSilent, autoFlares = settings.AutoFlares,
        onLock = settings.FlaresOnLock, players = settings.RocketPlayers, npcs = settings.RocketNPCs,
        vehicles = settings.RocketVehicles, targetKind = aviation.target and (aviation.target.vehicleHealth and "Vehicle" or "Character"),
        firingCallback = aviation.fireLoop ~= nil, aimState = aviation.reason}
end
local function aircraftTests()
    local results = {}
    for _, test in {
        {name="incoming ready",args={true,true,false,30,26,"IncomingProjectile",false},expected=true},
        {name="cooldown",args={true,true,false,20,26,"IncomingProjectile",false},expected=false},
        {name="manual F shares cooldown",args={true,true,false,0,26,"IncomingProjectile",false},expected=false},
        {name="active flares",args={true,true,true,30,26,"IncomingProjectile",false},expected=false},
        {name="not pilot",args={true,false,false,30,26,"IncomingProjectile",false},expected=false},
        {name="disabled",args={false,true,false,30,26,"IncomingProjectile",false},expected=false},
        {name="lock warning only",args={true,true,false,30,26,"Locking",false},expected=false},
        {name="optional lock defence",args={true,true,false,30,26,"Locking",true},expected=true},
        {name="unknown warning",args={true,true,false,30,26,"Other",true},expected=false},
    } do
        local actual = flareDecision(table.unpack(test.args))
        table.insert(results,{name=test.name,passed=actual==test.expected})
    end
    local config = rocketWeapon()
    local point = config and rocketPoint(aviation.plane)
    return {flares=results,status=aircraftStatus(),aimPoint=point,
        origin=config and rocketOrigin(aviation.plane,config),speed=config and config.MuzzleVelocity}
end

