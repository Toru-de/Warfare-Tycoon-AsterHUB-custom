                extendedState.reason,extendedState.target or "none",extendedState.meleeRequests,extendedState.bulletRequests,extendedState.errors))
            local air = aircraftStatus()
            local vehicleState=vehicleStatus()
            vehicleLabel:Set(string.format("Vehicles tracked: %d\nESP: %s\nRPG target: %s\nAssisted RPG shots: %d\n%s",vehicleState.tracked,
                vehicleState.espActive and "active in Mig-23" or "waiting for Mig-23 seat",vehicleState.rpgTarget or "none in FOV",rpg.assisted,rpg.reason))
            airStatusLabel:Set(string.format("Plane: %s\nWeapon: %s\nTarget: %s\nAim: %s\nS-8 salvos redirected: %d\nIncoming warnings: %d\nFlares sent / confirmed: %d / %d\nCooldown: %ds\nErrors: %d",
                air.plane or "not piloting Mig-23", air.weapon or "select S-8 Rockets", air.target or "none inside FOV", air.aimState or "waiting for a shot", air.assisted,
                air.incoming, air.flaresSent, air.flaresConfirmed, air.cooldownRemaining, air.errors))
