    local function getSortedThemeNames()
        local getSortedThemeNamesItems, getSortedThemeNamesItems2 = {}, {}
        for getSortedThemeNamesKey, getSortedThemeNamesItem in ipairs(items4) do
            if flowLibrary.ThemePresets[getSortedThemeNamesItem] then
                table.insert(getSortedThemeNamesItems, getSortedThemeNamesItem)
                getSortedThemeNamesItems2[getSortedThemeNamesItem] = true
            end
