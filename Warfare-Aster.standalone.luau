            local importDecodeConfig, importDecodeConfig2 = controlConfigManagerWindow:DecodeConfig(importValue)
            if not importDecodeConfig then
                updateControlConfigManagerState(false, "Import failed", "Invalid config code")
                return
            end

            local importStateValue = trimWhitespace(controlConfigManagerStateValue5:Get())
            if importStateValue == "" then
