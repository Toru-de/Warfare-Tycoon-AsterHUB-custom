        if windowTabIcon ~= nil and windowTabSuppliedOptions.Icon == nil then
            windowTabSuppliedOptions.Icon = windowTabIcon
        end
        local tab = setmetatable({
            Name = windowTabSuppliedOptions.Name or "Tab",
            Window = self,
            _order = 0,
        }, ContainerMethods)

        local windowTabButton = createInstance("TextButton", {
            Size = UDim2.new(1, 0, 0, tabHeight),
